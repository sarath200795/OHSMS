rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// OHS MS — unified, multi-tenant Firestore security rules.
//
// Model: every organization is a tenant. A user's profile (/users/{uid}) pins
// them to one orgId with a status (pending|approved) and a role. Members only
// ever touch their own organization's data; all module data lives under
// /organizations/{orgId}/<collection>. The public /orgIndex lets signup resolve
// an org by name without reading the member-only organizations collection.
//
// Module collections vary per feature (incidents, assessments, permits,
// inspectionRecords, extinguishers, consultations, …). Rather than enumerate
// them all, a generic per-org rule grants approved members access to any
// collection EXCEPT auditLogs, which stays append-only via its own rule.
//
// Roles bite in three places in that generic rule: an auditor cannot write at
// all, only a manager may delete, and only a manager may move a record into one
// of the states that record a decision (approved / closed / verified). See the
// "Manager-only decisions" block below for what counts and what does not.
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // An account still holding the password an admin typed for it reaches
    // NOTHING.
    //
    // Provisioning stamps mustChangePassword, and until now the only thing
    // honouring it was a React route guard — ProtectedRoute rendering a
    // different screen. The SDK never asked. So the account could read and
    // write the whole tenant from the browser console while still on the
    // password the provisioning admin chose and therefore knows, and nothing
    // expired that password. That is a credential the admin can use to act as
    // that employee, indefinitely, in a system whose value rests on who did
    // what.
    //
    // .get() with a default: every profile written before this field existed
    // has no such key, and reading it directly would raise — which denies, and
    // would have locked out every existing user of the app. The same shape that
    // refused every QR defect report for a day.
    //
    // Reading and updating your OWN profile deliberately do not go through this
    // (see /users below), or the change-password screen would be locked out of
    // clearing the flag it exists to clear.
    function passwordIsOwn() {
      return myProfile().get('mustChangePassword', false) != true;
    }

    function isApprovedMemberOf(orgId) {
      return hasProfile()
        && myProfile().orgId == orgId
        && myProfile().status == 'approved'
        && passwordIsOwn();
    }

    function isAdminOf(orgId) {
      return isApprovedMemberOf(orgId) && myProfile().role == 'admin';
    }

    // Unified roles: manager is elevated (approve/close/delete), auditor is
    // read-only, member is standard. Admin is implicitly allowed everything.
    function isManagerOf(orgId) {
      return isApprovedMemberOf(orgId)
        && (myProfile().role == 'admin' || myProfile().role == 'manager');
    }

    // Auditor is documented as read-only across every module, and until now
    // that was true only in React — `can()` hid the buttons while the rules
    // cheerfully accepted the same write from the SDK. An auditor is typically
    // an outside party given a login to inspect the safety record; being able
    // to edit the evidence they are auditing is the one thing the role exists
    // to prevent. Writes go through this instead of isApprovedMemberOf.
    function isWriterOf(orgId) {
      return isApprovedMemberOf(orgId) && myProfile().role != 'auditor';
    }

    // The operator of the platform itself, as opposed to an administrator of a
    // tenant inside it. The distinction is the whole point: an org admin
    // configures their own organization, and must not be able to hand their
    // organization modules it has not been given.
    //
    // Membership is a document under /platformAdmins that NO client operation
    // can write — see the match block below. It is deliberately not a role on
    // /users and not a custom claim derived from one, because an org admin
    // already edits /users for their own tenant (setUserRole) and a claim
    // mirrored from a document they control is a claim they control.
    function isPlatformAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid));
    }

    // ── The encryption keyset ────────────────────────────────────────────────
    // organizations/{orgId}/meta/cryptoKeys holds the organization's wrapped
    // data keys (functions/lib/dataKeys.js). NO CLIENT OPERATION IS ALLOWED ON
    // IT — not read, not write. The keys reach a member through the getDataKeys
    // callable, which decides class by class what their role entitles them to;
    // a client that could read this document would be going round that decision.
    //
    // Why it is a conjunct on the generic rules rather than a `match` of its
    // own: rules are a permissive union, so a narrow match denying everything
    // restricts nothing while `match /{col}/{docId}` still grants the same
    // access. The exclusion has to live where the grant lives, exactly as
    // auditLogs, defectLocks and docSeq do.
    //
    // Why the docId and not the whole `meta` collection: /meta also holds
    // meta/stats and the reference-number counters, which bumpStats and
    // reserveRefNo need every member to write. Excluding the collection would
    // stop anyone filing an incident.
    //
    // The WRITE side is the sharper of the two. The keys stored here are
    // wrapped under a Secret Manager master key and are useless to whoever
    // reads them, but the generic `allow create, update` grants isWriterOf on
    // /meta — so before this line any member could overwrite the keyset, and
    // every value already sealed under the replaced keys would become
    // permanently unreadable. Destroying a tenant's health records is a worse
    // outcome than reading one, and it was one setDoc away.
    function notKeyset(col, docId) {
      return !(col == 'meta' && docId == 'cryptoKeys');
    }

    // ── Module entitlements, enforced ─────────────────────────────────────────
    // /moduleEntitlements/{orgId} was defined above, platform-operator-write
    // only, and then referenced by NOTHING. Enforcement lived entirely in
    // React — ModuleGate and the sidebar — whose own header claimed the
    // opposite: "Firestore rules stop the data leaving, but an unguarded route
    // would still mount the module." They did not. The generic org rule hands
    // read and write on ANY collection under an organization to any approved
    // member, so a member of an org whose LOTO or PTW entitlement an operator
    // had revoked could still read and write those collections straight from
    // the SDK, and the console's switch meant nothing but a hidden tile.
    //
    // Declared HERE, at the top level, rather than inside
    // match /organizations/{orgId} where it was first written — because LOTO's
    // collections are not under an organization at all. `procedures`, `locks`,
    // `technicians` and `procedurePhotos` are TOP-LEVEL, tenanted by an orgId
    // field (see isLegacyOrgCollection), so a function scoped to the
    // organizations block could not reach the one module the comment above
    // names first. That is the shape of the original defect repeating itself:
    // the gate existed and did not cover the thing it was written for.
    //
    // This is a licensing control, not a tenant boundary — nobody reaches
    // another org's data either way — which is why it FAILS OPEN at every
    // point of doubt:
    //
    //   • a collection this list does not name is allowed (shared plumbing:
    //     sites, meta, docSeq, auditLogs, activity, and anything a module adds
    //     before someone updates this list),
    //   • an org with no entitlement document is allowed — ABSENT MEANS
    //     ENABLED, the same rule the client applies, so publishing this changed
    //     nothing for any existing organization,
    //   • a key absent from a document that exists is allowed, so a module
    //     added to the registry later is on until an operator turns it off.
    //
    // Only an explicit `false` refuses. That asymmetry is deliberate: the cost
    // of wrongly denying is a safety module going dark mid-shift; the cost of
    // wrongly allowing is a customer using something they have not paid for.
    //
    // A ternary chain rather than a map literal keyed by `col`. Both express
    // the same table, but this shape is already proven in this file
    // (decisionStates), and a rules file that fails to PARSE is rejected whole
    // — every other rule in it goes down with it. That is not a risk worth
    // taking for a lookup table on a ruleset that cannot be emulator-tested
    // here. It also evaluates far less per request.
    function moduleForCollection(col) {
      return col in ['incidents', 'illnesses', 'injuries'] ? 'incidents'
        : col == 'assessments' ? 'hira'
        : col in ['inspectionTemplates', 'inspectionRecords'] ? 'inspections'
        : col in ['audits', 'auditPlans', 'auditFindings', 'capas', 'findings'] ? 'audit'
        : col in ['permits', 'observations'] ? 'ptw'
        : col in ['procedures', 'procedurePhotos', 'locks', 'technicians'] ? 'loto'
        : col in ['extinguishers', 'aeds', 'fas', 'signages', 'reports'] ? 'equipment'
        : col == 'mockDrills' ? 'drills'
        : col == 'consultations' ? 'committee'
        : col in ['trainingCourses', 'trainingRecords', 'trainingAssignments',
                  'trainingSessions', 'trainingRequests'] ? 'training'
        : col == 'documents' ? 'documents'
        : col in ['erpContacts', 'erpLayouts', 'erpRescuePlans'] ? 'emergency'
        : col == 'objectives' ? 'objectives'
        : col in ['cctvCameras', 'cctvDvrs', 'cctvMeraki'] ? 'cctv'
        : col in ['escalations', 'legalIssues'] ? 'stakeholder'
        : '';
    }

    // Is this module key switched on for the org? The `let` matters: without it
    // moduleForCollection ran twice per call, and moduleAllowed is called on
    // both the generic match and its recursive {sub=**} twin.
    function moduleOn(orgId, key) {
      return key == ''
        || !exists(/databases/$(database)/documents/moduleEntitlements/$(orgId))
        || get(/databases/$(database)/documents/moduleEntitlements/$(orgId))
             .data.get(key, true) != false;
    }

    function moduleAllowed(orgId, col) {
      return moduleOn(orgId, moduleForCollection(col));
    }

    // A length cap that survives a null.
    //
    // The caps on the public QR surface were written as
    // `data.get('field', '').size() <= n`, and .get() only substitutes the
    // default when the key is ABSENT. reportPayload writes `newStatus: x ||
    // null` — the key is present, holding null — so .size() was called on null,
    // which raises, and a rule that raises denies.
    //
    // That is how a length check became an outage: every QR defect report was
    // refused, and createReport maps any permission-denied to "already
    // reported", so the person holding the phone was told the fault was a
    // duplicate. Nothing was wrong with their scan and nothing was in the
    // defectLocks collection at all.
    //
    // A non-string carries no length to police, so it passes here and is left
    // to the type and shape checks that already exist alongside.
    function shortText(v, max) {
      return !(v is string) || v.size() <= max;
    }

    // Stricter than shortText, for fields an ANONYMOUS writer supplies.
    //
    // shortText answers "is this string short enough", and lets anything that
    // is not a string straight through — which was the right call where it is
    // used, because .size() on a present-but-null value RAISES and a raising
    // rule denies (that refused every QR defect report for a day). But on a
    // public surface it leaves the hole open at a different angle: a megabyte
    // ARRAY in permitNo is not a string, so shortText waves it past.
    //
    // This keeps the null tolerance and closes that: absent or null is fine,
    // anything present must be a string and must be short. Note that
    // .get(k, '') already turns an absent key into '', so the null branch here
    // is specifically for a key present with an explicit null.
    function boundedText(v, max) {
      return v == null || (v is string && v.size() <= max);
    }

    // ── Manager-only decisions ────────────────────────────────────────────────
    // Approving a permit, deciding a defect report, verifying an injury,
    // closing a finding: each of these was enforced by can() in React and by
    // nothing else, so the same write went through unchallenged from the SDK.
    // The whole value of an approval is that only the approver could have made
    // it — a decision whose only guarantee is a hidden button is not one.
    //
    // Writing each module's state machine out in full would be unmaintainable
    // and would be wrong the first time someone adds a status. So only the
    // states that RECORD A DECISION are named. A member may still create the
    // record, edit it, and submit it for approval: 'pending', 'draft' and
    // 'pending_approval' are deliberately absent, because asking is not
    // deciding. What a member may not do is move a record into one of these.
    //
    // Nor back out of one. Clearing an approval is as much the approver's act
    // as granting it, and a rule watching only the way IN would let a member
    // wipe a decision and leave the record looking as though none was ever
    // made. Both sides of the write are read for that reason:
    // request.resource.data is the state AFTER the write, so on its own it
    // authorises nothing — the writer supplies it.
    //
    // Deliberately NOT decisions: an extinguisher reaching 'closed' (refilled —
    // the ordinary end of the fire workflow, recorded by whoever did the work),
    // an inspection template going Active, and a permit's
    // closedDueToObservation. Stopping unsafe work is not approving it, and a
    // rule that sent a member to find a manager before they could stop it would
    // be a safety defect, not a control.
    //
    // This governs `create` and `update` only. Reads are untouched, so none of
    // the list-constraint reasoning above applies to it.
    function decisionStates(col) {
      return col in ['permits', 'procedures', 'reports', 'observations',
                     'trainingRequests', 'erpRescuePlans']
               ? ['approved', 'rejected', 'declined']
           : col in ['incidents', 'illnesses', 'capas', 'findings', 'audits']
               ? ['closed', 'verified']
           // The internal-audit register capitalises its statuses.
           : col == 'auditFindings' ? ['Closed']
           : col == 'injuries' ? ['verified']
           // A document reaching 'active' becomes the controlled copy of record.
           : col == 'documents' ? ['active']
           : [];
    }

    // Does this write leave `path` alone, or move it only between undecided
    // states? An absent field reads as '', which is in no set, so a collection
    // that does not use a given field is never affected by it.
    function keeps(states, before, after, path) {
      let a = before.get(path, '');
      let b = after.get(path, '');
      return a == b || (!(a in states) && !(b in states));
    }

    // A permit has no status field at all: each approving team writes its own
    // decision block, and closure and extension carry another pair each.
    // `storedStatus` is derived from them and is re-persisted by whoever opens
    // the list, so gating that instead would deny ordinary browsing while
    // leaving the decisions themselves wide open.
    function keepsPermitDecisions(states, before, after) {
      return keeps(states, before, after, ['engineering', 'status'])
        && keeps(states, before, after, ['operations', 'status'])
        && keeps(states, before, after, ['closure', 'engineering', 'status'])
        && keeps(states, before, after, ['closure', 'operations', 'status'])
        && keeps(states, before, after, ['extension', 'engineering', 'status'])
        && keeps(states, before, after, ['extension', 'operations', 'status']);
    }

    // What a member may write: everything about the record except the decision.
    //
    // Rules are budgeted at 1000 expressions per request, and this rule is
    // evaluated twice for every write (the recursive subcollection match below
    // covers the parent document too). So the ungated collections — most of
    // them — exit on the size() check, and the six nested permit paths are only
    // walked for permits.
    function keepsDecision(col, before, after) {
      let s = decisionStates(col);
      return s.size() == 0
        || (keeps(s, before, after, ['status'])
            && keeps(s, before, after, ['approvalStatus'])
            // incidents and illnesses call it `lifecycle`.
            && keeps(s, before, after, ['lifecycle'])
            && (col != 'permits' || keepsPermitDecisions(s, before, after)));
    }

    // On a create there is no before state; an empty map defaults every field,
    // so creating a record already in a decided state is a move like any other.
    function beforeData() {
      return resource == null ? {} : resource.data;
    }

    // ── Site-scoped document visibility ───────────────────────────────────────
    // A document filed at Site level is readable only by people whose access
    // reaches that site. Everything else in the library stays org-wide, which is
    // what it was before, so this narrows one level and nothing else.
    //
    // The check must answer "does this user reach this site" WITHOUT reading the
    // site document. Rules allow ten document reads per request and twenty per
    // query, and a library list evaluates this rule once per document — one
    // get() per row would deny the whole query well before the page filled. So
    // the site's region and entity are snapshotted onto the document when it is
    // saved, and the rule reads only the profile it already has.
    //
    // The cost of that is honest and worth stating: moving a site to another
    // region does not re-file documents already saved against the old one.
    // See classificationFields() in modules/documents/lib/classification.js.
    function isElevatedOf(orgId) {
      return isApprovedMemberOf(orgId)
        && myProfile().role in ['admin', 'manager', 'auditor'];
    }

    // ── Read the queried document's fields DIRECTLY. This is not a style
    // preference, it is the difference between a boundary and a decoration.
    //
    // `read` covers get AND list, and for a list Firestore has to prove from
    // the rule alone that the query cannot return a document the rule refuses.
    // It can only do that when the condition names a field directly. Write it
    // defensively — resource.data.get('visibility','all'), or
    // !('visibility' in resource.data) || … , or keys().hasAny([…]) — and the
    // condition stops constraining the query: the single-document get is still
    // refused, but an unfiltered LIST returns every document in the collection,
    // contents and all. Verified against the emulator, all three forms.
    //
    // That failure is invisible to per-document tests, which is exactly how it
    // would have shipped. tests/documents.rules.test.js lists as well as gets.
    //
    // The cost is that `visibility` must exist on every document: direct access
    // to a missing field errors, and an erroring rule denies. So the backfill
    // is a PREREQUISITE, not a follow-up — scripts/backfill-document-visibility.mjs
    // runs BEFORE these rules deploy, or the existing library goes dark. See
    // docs/PRODUCTION.md §0c.
    //
    // Fields of OTHER documents are safe to read defensively: the profile is
    // fetched with get() and is constant across the query, so it constrains
    // nothing and `.get(…, default)` on it costs nothing.
    function reachesSite(d) {
      let p = myProfile();
      let a = p.get('access', {});
      // Their own posting counts, exactly as resolveAccessibleSites() has it.
      //
      // The empty-string guards are load-bearing. A site with no region stores
      // siteRegion: '', so without them a profile carrying '' in its regions —
      // an empty option submitted, a bad import, a hand-edited grant — would
      // match every document filed at a site that has no region set. The access
      // screen cannot produce that today, but the rule is the layer that stops
      // depending on what the app happens to produce.
      //
      // Still direct field access on the queried document, which is what keeps
      // list queries constrained. See the note above.
      return d.siteId != ''
        && (p.get('siteId', '') == d.siteId
            || a.get('sites', []).hasAny([d.siteId])
            || (d.siteRegion != '' && a.get('regions', []).hasAny([d.siteRegion]))
            || (d.siteEntity != '' && a.get('entities', []).hasAny([d.siteEntity])));
    }

    function canReadDocument(orgId, d) {
      return isApprovedMemberOf(orgId)
        && (isElevatedOf(orgId) || d.visibility != 'site' || reachesSite(d));
    }

    // ── Proof of scan ─────────────────────────────────────────────────────────
    // The public write surfaces exist for one person: someone standing in front
    // of an asset with their phone. Nothing used to check that. A report only
    // had to *claim* source=='qr', so anyone with curl could write into any
    // org's queue, for any asset id, forever — and the same held for the defect
    // locks, which meant a stranger could silently suppress fire-defect
    // reporting on equipment they had never seen.
    //
    // Requiring the scanned token, and checking it really does point at the
    // asset and org being written to, ties the write back to physical access.
    // That only works because /qr and /permitQr are no longer listable: the
    // token cannot be discovered, only scanned. The two fixes are load-bearing
    // for each other.
    //
    // This is not a rate limit — rules cannot count requests. It bounds WHO can
    // write and WHAT they can touch, not how often. App Check is what bounds
    // volume, and it is ENFORCED (docs/PRODUCTION.md §1). Read that as a
    // division of labour rather than belt-and-braces: nothing below here will
    // ever stop the same valid write arriving a million times, so if App Check
    // is ever turned off, these surfaces lose their only volume control.
    function hasToken(data) {
      return data.keys().hasAll(['token']) && data.token is string && data.token.size() > 0;
    }
    function scannedAsset(orgId, data) {
      return hasToken(data)
        && exists(/databases/$(database)/documents/qr/$(data.token))
        && get(/databases/$(database)/documents/qr/$(data.token)).data.orgId == orgId;
    }
    function scannedPermit(orgId, data) {
      return hasToken(data)
        && exists(/databases/$(database)/documents/permitQr/$(data.token))
        && get(/databases/$(database)/documents/permitQr/$(data.token)).data.orgId == orgId;
    }
    function scannedAssetField(data, field) {
      return get(/databases/$(database)/documents/qr/$(data.token)).data[field];
    }

    // ── Public org-name index (no sensitive fields) ───────────────────────────
    // Maps a lowercased org name to its orgId. Publicly readable because signup
    // has to resolve "which org is this?" before the user is a member of
    // anything.
    //
    // This was `create, update: if isSignedIn()`, which made it a tenant-hijack
    // primitive: anyone who registered an account could repoint an existing
    // org's entry at their own org, and every employee who subsequently signed
    // up by name would be enrolled into the attacker's tenant instead — where
    // the attacker is admin and reads everything they go on to file. Nothing in
    // the app writes an update, so the rule was granting authority the product
    // never used.
    //
    // Create is pinned with getAfter to the registration batch that also writes
    // the caller's own profile, exactly as /users/{uid} is: at that instant the
    // profile does not exist yet, so isApprovedMemberOf cannot be used. The same
    // condition covers the self-heal backfill for pre-index orgs, where the
    // caller is already a member of the org being indexed.
    // ── Public name → org index ───────────────────────────────────────────────
    // The KEY is the claim. This maps a company name to an orgId so signup can
    // resolve "Acme Manufacturing" without reading the member-only
    // organizations collection — which means whoever owns the entry for a name
    // owns where everyone typing that name ends up.
    //
    // Proving the writer owns the orgId in the PAYLOAD was never enough: it only
    // says "this is my org", not "my org is called that". Registering an org is
    // self-service, so that precondition cost one signup — and any company not
    // yet in the index (the reason ensureOrgIndex exists) was claimable by
    // anyone, capturing every one of its future joiners into the squatter's
    // tenant as pending members.
    //
    // So the org itself has to carry the name being claimed, and the key has to
    // be that name normalised the way the client normalises it
    // (orgData.js orgIndexKey: trim + lowercase). getAfter because
    // createOrganization writes the org, the profile and this entry in one batch.
    match /orgIndex/{key} {
      // Declared inside the match: `key` is only bound here.
      function claimsOwnName(orgId, name) {
        return getAfter(/databases/$(database)/documents/organizations/$(orgId)).data.name == name
          && name.trim().lower() == key;
      }

      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['orgId', 'name'])
        && request.resource.data.orgId is string
        && request.resource.data.name is string
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId
             == request.resource.data.orgId
        && claimsOwnName(request.resource.data.orgId, request.resource.data.name);

      // An entry may be corrected by its own org, but never repointed elsewhere
      // and never renamed to something the org is not called. Since the key IS
      // the normalised name, this now only permits fixing case or stray
      // whitespace — a genuinely different name is a different entry, which is
      // the correct semantic for a key that is the name.
      allow update: if isApprovedMemberOf(resource.data.orgId)
        && request.resource.data.keys().hasOnly(['orgId', 'name'])
        && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.name is string
        && claimsOwnName(resource.data.orgId, request.resource.data.name);

      allow delete: if false;
    }

    // ── Public QR mirror (fire equipment) ─────────────────────────────────────
    // A minimal, publicly-readable copy of an extinguisher / AED / fire-alarm
    // device, keyed by its qrToken, so anyone scanning the QR code can view the
    // asset without signing in. Written (create/update/delete) only by an
    // approved member of the owning org — the write rides in the same batch as
    // the org-scoped asset write, so the member is already authorised there.
    // `get`, NOT `read`. In Firestore, `read` = `get` + `list`, and a wildcard
    // match with an unconditional allow grants BOTH — so `allow read: if true`
    // let an unauthenticated stranger page the entire collection and walk away
    // with every tenant's asset register. Verified against production before
    // this change: 842 documents, no credential, one curl.
    //
    // Token unguessability was the whole security model here, and listing
    // defeats it without guessing anything. The app has only ever fetched these
    // by exact token (QrLanding does getDoc(doc(db,'qr',token))), so `get`
    // alone costs nothing and `list` was authority the product never used.
    // The update rule is pinned to the org that ALREADY owns the mirror.
    //
    // It used to read `isApprovedMemberOf(resource.data.orgId)
    //   || isApprovedMemberOf(request.resource.data.orgId)`, and the second
    // branch is evaluated against the POST state — so a write that simply set
    // orgId to the caller's own org satisfied it no matter who owned the
    // document. One signup gives anyone an approved admin profile in a throwaway
    // org, and the token is not a secret in the field: it is printed on the
    // sticker. So a photograph of someone else's extinguisher label was enough
    // to re-point that unit's public QR page into the attacker's tenant, where
    // every future defect report scanned from it would land — while the person
    // scanning is told it was submitted, and the owner's safety team never
    // hears about it. The same call against a permit mirror can show a fire
    // watcher an expired hot-work permit as approved.
    //
    // Pinning orgId across the write closes it without costing anything: every
    // legitimate writer already owns the mirror it is updating, and a merge
    // write carries the existing orgId through to the post state.
    //
    // isWriterOf rather than isApprovedMemberOf, for the same reason the org
    // collections use it: this mirror is what a stranger with a phone is shown,
    // and an auditor rewriting it could mark a faulty extinguisher ready for use
    // on the page the next person to scan it reads.
    match /qr/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if isWriterOf(request.resource.data.orgId);
      allow update: if resource != null
        && isWriterOf(resource.data.orgId)
        && request.resource.data.orgId == resource.data.orgId;
      allow delete: if isWriterOf(resource.data.orgId);
    }

    // ── Public LOTO procedure mirror ──────────────────────────────────────────
    // The QR printed on an isolation procedure is stuck to a machine, and the
    // person scanning it is standing in front of that machine — usually with no
    // account. This is what they read: what to isolate, how, the hazard, how to
    // prove it dead, and whether each point is locked RIGHT NOW.
    //
    // A mirror rather than opening /procedures/{id}, because rules cannot
    // restrict which FIELDS a read returns. The procedure document carries
    // lockState.techName, groupLock.members[].name, primaryTech and the approval
    // trail; publishing it would put workers' names on an unauthenticated URL.
    // src/modules/loto/utils/publicProcedure.js whitelists what lands here.
    //
    // `get`, NOT `read` — the same distinction that mattered for /qr above.
    // read = get + list, and an unconditional read would let anyone page the
    // whole collection and walk off with every tenant's isolation procedures.
    // The document id is the procedureId (the printed codes encode /p/<id>), so
    // get-by-exact-id is all the app has ever needed.
    //
    // Writes are pinned to the owning tenant and ride in the same batch or
    // transaction as the procedure write, so the two cannot disagree.
    match /procedureQr/{procedureId} {
      allow get: if true;
      allow list: if false;

      // The document ID is another tenant's procedure ID, so owning the org in
      // the PAYLOAD is not enough — that only proves the writer owns the org
      // they named, never that they own the procedure this mirror speaks for.
      // Without the second clause any tenant could plant a mirror at someone
      // else's procedure ID and serve attacker-written isolation instructions
      // at the URL printed on that machine; worse, the real owner could then
      // never overwrite it, because update pins to the squatter's orgId.
      //
      // getAfter, not get: createProcedure writes the procedure and this mirror
      // in ONE batch, so at get() time the procedure does not exist yet. The
      // backfill path has it committed already and getAfter reads the same.
      allow create: if isWriterOf(request.resource.data.orgId)
        && getAfter(/databases/$(database)/documents/procedures/$(procedureId)).data.orgId
             == request.resource.data.orgId;

      allow update: if resource != null
        && isWriterOf(resource.data.orgId)
        && request.resource.data.orgId == resource.data.orgId;
      // Pinned to the mirror's own org rather than the procedure's: delete runs
      // in the same batch that deletes the procedure, so nothing would be left
      // for getAfter to read.
      allow delete: if resource != null && isWriterOf(resource.data.orgId);
    }

    // Public mirror for the QR code printed on a work permit. Same shape of
    // rule as /qr above and for the same reason: whoever scans a permit taped
    // to a scaffold — a contractor, an auditor, a fire watcher — has no account
    // and must still be able to read whether it is valid right now.
    //
    // The mirror is a copy, not the permit: it carries no approvals, no
    // decisions and no attached documents, and nothing can be written back
    // through it. The token is 18 random characters, so it is unguessable and
    // is the only thing linking a scan to a permit.
    // Same split as /qr above, and it mattered more here: these mirrors carry
    // job location, hazards, the issuer's and holder's names, fire watchers and
    // the full participant list with each worker's employer — so a collection
    // list was a cross-tenant PII dump, not just an inventory leak.
    // Same pin as /qr, and for the same reason — see the note above it.
    match /permitQr/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if isWriterOf(request.resource.data.orgId);
      allow update: if resource != null
        && isWriterOf(resource.data.orgId)
        && request.resource.data.orgId == resource.data.orgId;
      allow delete: if isWriterOf(resource.data.orgId);
    }

    // ── Ported-module top-level collections (LOTO / hecp-loto) ─────────────────
    // These modules scope tenancy with an `orgId` field on each document instead
    // of an org subcollection path. Approved members of that org may read/write;
    // managers+ may delete. This wildcard returns false for every other top-level
    // collection (users, organizations, qr, orgIndex), which keep their own rules.
    // lotoEvents is deliberately NOT here. It gets its own append-only rule
    // below, and because rules are a permissive UNION a narrower match would
    // restrict nothing while this wildcard still granted the collection — the
    // same reason the generic org rule excludes auditLogs.
    //
    // `sites` USED to be in this list and is not any more. The site registry
    // lives at /organizations/{orgId}/sites and always has — every module reads
    // it through subscribeSites in shared/org/orgData.js. The only code that
    // ever touched a ROOT /sites collection was loto/services/sites.js, which
    // was imported by nothing: LOTO's own CreateProcedure page uses the shared
    // registry like everyone else. So this granted read and write on a
    // top-level collection that no code in the app has ever used, which is the
    // worst kind of permission — one nobody can notice is wrong, because
    // nothing exercises it. Removing it takes nothing away from the app and
    // takes a whole collection away from an attacker.
    //
    // This is an intended semantic change: the rules test count MOVES here.
    function isLegacyOrgCollection(col) {
      return col in ['procedures', 'procedurePhotos', 'locks', 'technicians'];
    }

    // ── LOTO activity trail ───────────────────────────────────────────────────
    // Who applied and who removed a padlock on live plant: the document an
    // investigator reads after somebody is hurt. It was described as append-only
    // and was not — the wildcard above let any approved member rewrite an entry,
    // a manager delete one, and anyone create one naming a colleague as the
    // person who unlocked the machine.
    //
    // Same shape as /auditLogs: the actor is the caller, the time is the
    // server's, and nothing can be edited or removed afterwards. setPointLock,
    // addGroupMember and removeGroupMember already write `by` from the signed-in
    // user and `at` from serverTimestamp(), so no legitimate write changes.
    // ── LOTO padlock claims ───────────────────────────────────────────────────
    // One document per padlock currently applied, keyed `${orgId}__${lockNo}`.
    // The document ID carries the value, which is what makes the uniqueness
    // real: two people claiming lock 12 are two writes to one document, and
    // Firestore serialises those. The transaction in services/lockClaims.js
    // explains why the previous in-procedure and in-browser checks could not.
    //
    // Deliberately NOT added to isLegacyOrgCollection: that rule's create grant
    // has no `resource == null`, so a claim could be overwritten in place —
    // which is exactly the "two machines, one padlock" state the collection
    // exists to make impossible. Same reasoning as /defectLocks.
    match /lockClaims/{claimId} {
      allow read: if resource != null && isApprovedMemberOf(resource.data.orgId);

      // resource == null is the guarantee, not decoration. Without it a second
      // claimant's create succeeds by overwriting the first, and the padlock is
      // recorded on their machine while it physically hangs on someone else's.
      //
      // The ID PREFIX must match the payload's org, the same way /defectLocks
      // binds its lockId. Checking only request.resource.data.orgId proves the
      // writer owns the org they NAMED, never that they own the id they are
      // writing at — and the id is `${orgId}__${lockNo}`, so without this a
      // stranger could take out a claim at another tenant's address:
      //
      //   sign up → create a throwaway org (self-service, so isWriterOf passes
      //   for it) → read victim orgIds out of the world-readable /orgIndex →
      //   create lockClaims/VICTIM__12 carrying {orgId: <own org>}.
      //
      // That is worse than squatting. readLockClaims does tx.get on this
      // document inside the lock transaction, and the read rule keys off
      // resource.data.orgId — the attacker's — so the victim's get is REFUSED
      // and the whole setPointLock transaction fails permission-denied. The
      // victim cannot delete it either, for the same reason. Padlock 12 becomes
      // permanently unusable in their isolation system, repeatable across every
      // lock number and every org in the index.
      //
      // orgId is a Firestore auto-id ([A-Za-z0-9]{20}), so it can never itself
      // contain '__' and the first split segment is always exactly the org.
      allow create: if isWriterOf(request.resource.data.orgId)
        && resource == null
        && claimId.split('__')[0] == request.resource.data.orgId;

      // Update exists only so re-asserting a claim the SAME procedure already
      // holds is not an error (a personal→department swap can land on the same
      // number). Pinned to the existing org and procedure so it can never be
      // used to take a live claim over: moving a claim to another procedure is
      // release-then-claim, which has to survive the create rule above.
      allow update: if resource != null
        && isWriterOf(resource.data.orgId)
        && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.procedureId == resource.data.procedureId;

      // Any writer in the org may release: a padlock outliving the person who
      // applied it is routine (shift change, someone off sick), and a claim
      // nobody can clear strands the physical lock — the failure that teaches
      // people to work around the system. The activity trail in /lotoEvents is
      // where accountability lives, and it is append-only.
      allow delete: if resource != null && isWriterOf(resource.data.orgId);
    }

    match /lotoEvents/{eventId} {
      allow read: if resource != null && isApprovedMemberOf(resource.data.orgId);
      allow create: if isWriterOf(request.resource.data.orgId)
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }
    // moduleAllowed on every branch below. LOTO is the module the entitlement
    // comment names FIRST, and it was the one module the entitlement gate could
    // not see: these four collections are top-level, tenanted by an orgId field
    // rather than by path, so the conjunct added to the generic
    // /organizations/{orgId}/{col}/{docId} rule never reached them. An operator
    // switching LOTO off changed a sidebar tile and nothing else.
    //
    // moduleForCollection maps all four legacy names onto 'loto', so this is the
    // same table and the same fail-open semantics as everywhere else.
    //
    // `delete` is left ungated, matching the generic rule: turning a module off
    // should stop it being used, not trap the records already in it.
    match /{legacyCol}/{docId} {
      allow read: if isLegacyOrgCollection(legacyCol)
        && resource != null && isApprovedMemberOf(resource.data.orgId)
        && moduleAllowed(resource.data.orgId, legacyCol);
      // isWriterOf, not isApprovedMemberOf. These collections were the one place
      // the read-only auditor role was still only read-only in React: an auditor
      // could edit the isolation procedure they were auditing, and the LOTO
      // adapter maps auditor onto its `technician` role, which carries
      // loto.perform — so the buttons were there too. See the note on isWriterOf.
      allow create: if isLegacyOrgCollection(legacyCol)
        && isWriterOf(request.resource.data.orgId)
        && moduleAllowed(request.resource.data.orgId, legacyCol)
        && (isManagerOf(request.resource.data.orgId)
            || keepsDecision(legacyCol, {}, request.resource.data));
      // Pinned the same way as /qr above: the post-state branch let one org
      // capture another's document by rewriting orgId to its own in a single
      // update, which for LOTO means taking over a live isolation procedure.
      allow update: if isLegacyOrgCollection(legacyCol)
        && resource != null
        && isWriterOf(resource.data.orgId)
        && moduleAllowed(resource.data.orgId, legacyCol)
        && request.resource.data.orgId == resource.data.orgId
        && (isManagerOf(resource.data.orgId)
            || keepsDecision(legacyCol, resource.data, request.resource.data));
      allow delete: if isLegacyOrgCollection(legacyCol)
        && resource != null && isManagerOf(resource.data.orgId);
    }

    // ── Platform ownership ────────────────────────────────────────────────────
    // One document per person who operates the platform. Existence IS the
    // grant; the body is only there so a human reading the console can tell
    // whose uid it is.
    //
    // Nothing in the app can create, edit or remove one. That is not an
    // oversight to be fixed later — it is the reason the collection is
    // trustworthy. A path that could write it would be a path an org admin
    // could be tricked into, or find. The only ways in are the Firebase console
    // and the Admin SDK, both of which already require project-level access,
    // which is the same authority this collection is standing in for.
    //
    // `get` and not `read`: a signed-in member may ask whether THEY hold the
    // grant, which is what the client needs to decide whether to offer the
    // console. `list` would turn that into a roster of the platform's operators
    // — a target list — for anyone with an account.
    match /platformAdmins/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list: if false;
      allow write: if false;
    }

    // ── Per-organization module entitlements ──────────────────────────────────
    // Which of the modules in the registry an organization may see and use.
    //
    // A top-level collection rather than a field on /organizations, because
    // `allow update: if isAdminOf(orgId)` governs that document — so an org
    // admin could switch their own modules back on, and an entitlement a tenant
    // can grant itself is not an entitlement.
    //
    // Every approved member reads it: the shell has to know which tiles to draw
    // and which routes to refuse, and that decision belongs to the person
    // sitting in front of the app. Only the platform operator writes it.
    //
    // ABSENT MEANS ENABLED. An organization with no document here gets the full
    // product, which is what every organization had before this collection
    // existed — so shipping it changed nothing for anyone until an operator
    // says otherwise. It also means a module added to the registry later is on
    // by default rather than silently withheld from every existing tenant until
    // someone re-saves each one.
    match /moduleEntitlements/{orgId} {
      allow get: if isApprovedMemberOf(orgId) || isPlatformAdmin();
      allow list: if isPlatformAdmin();
      // The shape is pinned so a stray write cannot park unrelated data in a
      // document every member of the tenant can read.
      // hasAll BEFORE the field is read. Reading an absent field raises rather
      // than evaluating false — the same shape that turned a missing orgId on a
      // QR mirror into a denial nobody could explain — so a payload with no
      // `modules` key has to be refused by the key check, not by touching it.
      allow create, update: if isPlatformAdmin()
        && request.resource.data.keys().hasAll(['modules', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['modules', 'updatedAt', 'updatedBy', 'updatedByEmail'])
        && request.resource.data.modules is map
        && request.resource.data.updatedBy == request.auth.uid;
      // Deleting the document restores the default — the full product — which
      // is a legitimate thing for an operator to want, and is not a way to
      // gain anything: it is the state every org starts in.
      allow delete: if isPlatformAdmin();
    }

    // ── User profiles ─────────────────────────────────────────────────────────
    match /users/{uid} {
      // Read your own profile, or — once you are an APPROVED member — any
      // profile in your organization.
      //
      // This used to say hasProfile(), which tests existence rather than
      // approval. Joining is self-service: anyone can create their own profile
      // as {status:'pending'} naming any orgId, and orgIds are public via
      // orgIndex. So a stranger could sign up against a company they have no
      // connection to and, while still sitting unapproved in that company's
      // queue, read its entire staff directory — every name, email, role and
      // department. Approval is the gate that was meant to be here; pending is
      // exactly the state that should see nothing but itself.
      allow read: if isSignedIn()
        && (request.auth.uid == uid
            || (isApprovedMemberOf(resource.data.orgId)
                && resource.data.orgId == myProfile().orgId));

      // Create your own profile (joining as a pending member, or — if you just
      // created the org — as its approved admin), OR an org admin provisions an
      // employee account for their own org (never directly as admin; admins are
      // promoted afterwards through the managed role update below).
      // The approved-admin self-create exists for one moment only: registering
      // a NEW organization, which writes the org doc and this user doc in one
      // batch. getAfter pins that: within the batch the org must exist with
      // createdBy == this caller. Without it, anyone could read an orgId out of
      // the public orgIndex and write themselves in as that org's admin.
      // `access` and `siteId` are pinned on CREATE for exactly the reason the
      // update rule below pins them, and for a while only update did. The two
      // rules guard the same privilege at two moments, and a privilege guarded
      // at one moment is not guarded: joining is self-service, orgIds are public
      // through /orgIndex, and approval only flips `status` — setUserStatus
      // (src/shared/org/orgData.js) writes { status } and nothing ever
      // re-asserts what else the joiner put in their own document. So a stranger
      // could write themselves in as {status:'pending', role:'member'} — both
      // values the rule checks — carrying an `access` map naming every site in
      // the victim org, and the admin clicking Approve on what reads as a
      // routine join request silently granted it. From there reachesSite() and
      // canReadDocument() hand over every site-restricted document, without the
      // role ever moving. Identical to the role escalation the comment below
      // describes; the same fix, at the same moment.
      //
      // Empty, not merely unchanged: a create has no prior state, and the only
      // correct starting scope is none. An admin grants scope afterwards through
      // the update rule, which is the one place a screen does it. The admin
      // branch is pinned too — provisioning an employee is not the moment to
      // decide what they can see, and that branch runs on the admin's say-so for
      // a document with someone else's uid.
      function noSelfGrantedScope() {
        return request.resource.data.get('siteId', '') == ''
          && request.resource.data.get('access', {}).get('sites', []).size() == 0
          && request.resource.data.get('access', {}).get('regions', []).size() == 0
          && request.resource.data.get('access', {}).get('entities', []).size() == 0;
      }

      allow create: if isSignedIn()
        && noSelfGrantedScope()
        && (
          (request.auth.uid == uid
            // 'member', not merely "not admin". A self-joining stranger used to
            // be able to name themselves 'manager' while pending, and approval
            // only flips status — nothing ever re-asserts the role — so the
            // admin clicking Approve on what looked like a routine join request
            // was silently granting the elevated role the joiner had chosen for
            // themselves. Promotion is the admin's to make, afterwards.
            && ((request.resource.data.status == 'pending' && request.resource.data.role == 'member')
                || (request.resource.data.status == 'approved'
                    && request.resource.data.role == 'admin'
                    && getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)).data.createdBy == request.auth.uid)))
          || (isAdminOf(request.resource.data.orgId) && request.resource.data.role != 'admin')
        );

      // Update your own limited fields, or an admin manages members in the same
      // org. Users cannot self-promote (role/status locked unless admin).
      //
      // BOTH branches must pin orgId, and for a while only the first one did.
      // Because the branches are OR'd, an admin editing their OWN document took
      // the second branch — which constrained nothing — and could rewrite their
      // orgId to any value. Registering an org is open to anyone, so the whole
      // path was: sign up, create a throwaway org (you are its admin), read a
      // victim orgId out of the public orgIndex, then update your own profile to
      // {orgId: victim, role: admin, status: approved}. isAdminOf() reads the
      // profile you just wrote, so you land as an approved admin of an org you
      // have never belonged to, with read and write over all of its data.
      //
      // An admin manages members OF THEIR OWN ORG. Moving a person to a
      // different org — themselves most of all — is not management, and no
      // screen in the app does it.
      allow update: if isSignedIn()
        && request.resource.data.orgId == resource.data.orgId
        && (
          // `access` and `siteId` are pinned alongside role and status, because
          // they are no less a privilege than role is. They decide which sites
          // a person resolves to, and site-level documents are now readable
          // only by people whose access reaches the site — so a member who can
          // rewrite their own access grants themselves every restricted
          // document in the org from the browser console, without ever
          // touching their role. Only an admin changes who can see what.
          (request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.status == resource.data.status
            && request.resource.data.get('siteId', '') == resource.data.get('siteId', '')
            && request.resource.data.get('access', {}) == resource.data.get('access', {}))
          || isAdminOf(resource.data.orgId)
        );

      allow delete: if isAdminOf(resource.data.orgId);
    }

    // ── Organizations & all org-scoped module data ────────────────────────────
    match /organizations/{orgId} {
      allow read: if isApprovedMemberOf(orgId);
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAdminOf(orgId);

      // Append-only audit trail — create only, never edit or delete. Declared
      // before the generic rule; the generic rule below excludes auditLogs so
      // this is the only rule that governs it.
      // An append-only trail is only evidence if the name on an entry is the
      // person who made it. Creation was unvalidated, so any approved member
      // could write entries attributing whatever they liked to an admin — and
      // the trail that would show them doing it is the same one they are
      // writing. Pinning actorUid to the caller's own uid makes an entry mean
      // what it says; the rest of the payload stays free-form because the trail
      // records many different shapes.
      match /auditLogs/{logId} {
        allow read: if isApprovedMemberOf(orgId);
        // actorUid pins WHO. `at == request.time` pins WHEN, and without it a
        // member could write a real entry under their own uid, dated last
        // Tuesday, describing an action taken by someone else — every human
        // reading the page sees a plausible backdated event, and only someone
        // querying Firestore directly could tell. Every app-side writer already
        // uses serverTimestamp(), so nothing legitimate changes.
        //
        // actorName may only be YOUR name, or one of the writers' fallbacks.
        //
        // It was left entirely free, on the reasoning that it is a display
        // string and the uid beside it is the fact, and that pinning it would
        // cost a profile read. The second half was wrong: isApprovedMemberOf on
        // the line above already reads the profile, and rules cache document
        // reads within a request, so this is free. The first half underrates the
        // attack — a member could write actorUid = their own uid with actorName
        // = 'Priya (Safety Manager)', and every human reading the page sees a
        // plausible action by someone else. Only somebody querying Firestore
        // directly would notice, which is nobody.
        //
        // Not pinned to the profile name ALONE, because logAudit falls back to
        // 'Unknown' when an actor has no name, and logAudit deliberately
        // swallows its own failures so an audit write can never break the
        // action it describes. A strict pin would therefore stop recording
        // those users SILENTLY — losing the trail is worse than a soft name.
        // .get() with a default for the same reason it is used elsewhere: a
        // profile without a name would otherwise raise, which denies.
        allow create: if isApprovedMemberOf(orgId)
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.at == request.time
          // .get() on BOTH sides. An entry written without an actorName at all
          // is legitimate — several writers omit it — and reading an absent key
          // directly raises, which denies. Getting that wrong here would have
          // silently stopped recording, which is the one failure an audit trail
          // must not have.
          && (request.resource.data.get('actorName', '') == myProfile().get('name', '')
              || request.resource.data.get('actorName', '') == 'Unknown'
              || request.resource.data.get('actorName', '') == '');
        allow update, delete: if false;
      }

      // One open report per defect per unit, enforced as a document rather than
      // a check. The QR reporter is not signed in and must never be able to read
      // the org's reports, so the client cannot look for a duplicate before
      // submitting — but creating a document that already exists fails by
      // itself: the write IS the check. That is why update is denied here and
      // why this collection is carved out of the generic member rule below.
      //
      // It holds no personal data, only which defect is live on which unit, and
      // is written in the same batch as the report it guards.
      //
      // That made it a denial-of-service primitive. The id is derived
      // (`extId__defectType`), creation needed no account, and createReport
      // batches the lock with the report — so pre-creating locks made every
      // genuine defect report fail, and the reporter was told the fault was
      // "already reported". Silent, indefinite, and pointed at fire equipment.
      //
      // Two bindings close it. The id must match the payload, so a scanner
      // cannot claim one unit and lock another. And a public writer must
      // present the token of the very asset they are locking — which they can
      // only get by scanning it.
      // Split so the auditor keeps the read and loses the write: pre-creating a
      // lock, or deleting one, is how the DoS above worked, and "read-only" has
      // to mean it here too.
      match /defectLocks/{lockId} {
        allow read: if isApprovedMemberOf(orgId);
        allow delete: if isWriterOf(orgId);
        allow create: if request.resource.data.keys().hasOnly(['extId', 'defectType', 'createdAt', 'token'])
          && request.resource.data.extId is string
          && request.resource.data.extId.size() > 0
          && request.resource.data.extId.size() < 200
          && request.resource.data.defectType is string
          && request.resource.data.defectType.size() > 0
          && request.resource.data.defectType.size() <= 60
          // lockId() escapes '/' before joining; forbid it on both sides so the
          // client's id and this comparison cannot mean different things.
          && !request.resource.data.extId.matches('.*/.*')
          && !request.resource.data.defectType.matches('.*/.*')
          && lockId == request.resource.data.extId + '__' + request.resource.data.defectType
          && (
            isWriterOf(orgId)
            || (scannedAsset(orgId, request.resource.data)
                && scannedAssetField(request.resource.data, 'extId') == request.resource.data.extId)
          );
        allow update: if false;
      }

      // Defect reports raised by scanning an equipment QR code. Whoever spots a
      // discharged extinguisher is rarely a portal user, and requiring an
      // account first is how defects go unreported — so an unauthenticated
      // create is allowed, but only in the exact shape the QR page produces:
      // a pending defect report that an approver must still accept. It cannot
      // be used to write an approved record, change status, or edit anything.
      // Note this is a public write surface. App Check is enforced and is what
      // bounds the volume of abuse; the shape constraints below are what bound
      // its reach.
      // hasOnly matters more here than anywhere else: this rule validated a
      // handful of named fields but never the key SET, so an anonymous writer
      // could attach anything else they liked and fill a document to Firestore's
      // ~1 MiB ceiling, unlimited times, on someone else's bill. The list below
      // is the union of what reportPayload() and createAssetReport() write.
      // hasOnly sits INSIDE the public branch, not above both. Rules are a
      // permissive union and /reports is also covered by the generic org
      // collection rule below, so a constraint on the member branch here would
      // be silently overridden by that rule granting the same write — the kind
      // of protection that reads as real and enforces nothing. What matters is
      // that the ANONYMOUS branch is exhaustively bounded.
      //
      // The member branch that used to sit here (`isApprovedMemberOf(orgId) ||`)
      // is gone, and its absence is the point. It was the broader match of the
      // pair: it let an AUDITOR file a report, and once approving one became a
      // manager's act it would have let any member create a report that was
      // already approved and skip the queue entirely. Signed-in writers go
      // through the generic rule, exactly as the comment above always claimed.
      match /reports/{reportId} {
        allow create: if (
              request.resource.data.keys().hasOnly([
                'extId', 'extLabel', 'kind', 'defectType', 'newStatus', 'note',
                'reportedBy', 'reportedByName', 'reporterRole', 'source',
                'approvalStatus', 'reportedAt', 'createdAt', 'token',
                'assetKind', 'assetRefId', 'assetLabel', 'defect',
              ])
              && request.resource.data.source == 'qr'
              // The scanned token must exist and belong to THIS org. Without it,
              // orgId was just a path segment an anonymous writer picked, so a
              // stranger could file into any tenant's approval queue.
              && scannedAsset(orgId, request.resource.data)
              && request.resource.data.approvalStatus == 'pending'
              && request.resource.data.reportedBy == 'public'
              && request.resource.data.note is string
              && request.resource.data.note.size() <= 500
              // `note` was the only free string anyone had bounded, so every
              // other one on this ANONYMOUS branch was unbounded — a person
              // holding one scanned token could push a megabyte per write into
              // the org's approval queue, repeatedly, for free. These are labels
              // and roles copied off a sticker; 200 is generous for all of them.
              // .get() defaults an absent optional field to '', which passes.
              && boundedText(request.resource.data.get('extLabel', ''), 200)
              && boundedText(request.resource.data.get('assetLabel', ''), 200)
              && boundedText(request.resource.data.get('defectType', ''), 200)
              && boundedText(request.resource.data.get('newStatus', ''), 60)
              && boundedText(request.resource.data.get('reportedByName', ''), 120)
              && boundedText(request.resource.data.get('reporterRole', ''), 60)
              && (
                // An extinguisher defect, keyed by the unit it was raised
                // against — and that unit must be the one the token names,
                // otherwise a single scanned QR let someone report faults on
                // every other asset in the org.
                (
                  request.resource.data.kind == 'defect'
                  && request.resource.data.extId is string
                  && request.resource.data.extId.size() > 0
                  && request.resource.data.extId.size() < 200
                  && scannedAssetField(request.resource.data, 'extId') == request.resource.data.extId
                )
                // An AED or fire-alarm fault. Same public surface, different
                // sheet: these carry no extId, so the extinguisher clause above
                // can never admit them and they need their own shape. assetKind
                // is pinned to the two known kinds because approving one writes
                // to the matching collection — an unrecognised kind would target
                // nothing — and it must agree with the mirror too.
                || (
                  request.resource.data.kind == 'asset_defect'
                  && request.resource.data.assetKind in ['aed', 'fas']
                  && request.resource.data.assetRefId is string
                  && request.resource.data.assetRefId.size() > 0
                  && request.resource.data.assetRefId.size() < 200
                  && request.resource.data.defect is string
                  && request.resource.data.defect.size() > 0
                  && request.resource.data.defect.size() <= 200
                  && scannedAssetField(request.resource.data, 'assetRefId') == request.resource.data.assetRefId
                  && scannedAssetField(request.resource.data, 'assetKind') == request.resource.data.assetKind
                )
              )
          );
      }

      // Observations logged by scanning a work permit's QR code. Whoever walks
      // past unsafe hot work is usually not a portal user, and requiring an
      // account first is how it goes unreported — so an unauthenticated create
      // is allowed, but only in the exact shape the public permit page writes.
      //
      // It lands pending and touches nothing else. A signed-in "unsafe"
      // observation closes the permit for non-compliance on the spot; allowing
      // that here would put a stop-work button on a token printed on a sheet of
      // paper, so the scan reports and a person decides.
      //
      // Note this is a public write surface. App Check is enforced and is what
      // bounds the volume of abuse; the shape constraints below are what bound
      // its reach.
      // Same two gaps as /reports, closed the same way: the key set was never
      // constrained, and the permit being observed was a string the writer
      // invented in a tenant they chose by editing the path.
      //
      // The member branch is gone for the same reason as /reports — see there.
      match /observations/{obsId} {
        allow create: if (
              request.resource.data.keys().hasOnly([
                'permitId', 'permitNo', 'docId', 'token', 'type', 'note',
                'observedBy', 'observedByName', 'observedByRole', 'source',
                'approvalStatus', 'at',
              ])
              && request.resource.data.source == 'qr'
              && scannedPermit(orgId, request.resource.data)
              && get(/databases/$(database)/documents/permitQr/$(request.resource.data.token)).data.permitId
                   == request.resource.data.permitId
              && request.resource.data.approvalStatus == 'pending'
              && request.resource.data.observedBy == 'public'
              && request.resource.data.type in ['safe', 'unsafe']
              && request.resource.data.permitId is string
              && request.resource.data.permitId.size() > 0
              && request.resource.data.permitId.size() < 200
              && request.resource.data.note is string
              && request.resource.data.note.size() <= 500
              // note and permitId were the only two anyone had bounded, so the
              // other free strings on this ANONYMOUS branch had no ceiling at
              // all. Whoever photographs a permit QR taped to a scaffold holds
              // a valid token indefinitely, and scannedPermit() only proves the
              // token exists and belongs to the org — it does not bound what
              // rides in beside it. One token, repeated writes, a megabyte at a
              // time, into the queue a manager has to read. The same hole was
              // found and closed on /reports; this is the sibling nobody went
              // back for.
              //
              // The client only ever writes short values (ptw/lib/firestore.js
              // addObservation), so nothing legitimate needs the headroom.
              && boundedText(request.resource.data.get('permitNo', ''), 120)
              && boundedText(request.resource.data.get('docId', ''), 120)
              && boundedText(request.resource.data.get('observedByName', ''), 120)
              && boundedText(request.resource.data.get('observedByRole', ''), 60)
              && boundedText(request.resource.data.get('token', ''), 200)
          );
      }

      // Document-id counters, one document per kind, holding a single integer.
      //
      // Every member must be able to increment these — reserving an id is what
      // creating any record does — but a counter that can move BACKWARDS hands
      // the next record an id already printed on a permit and quoted in the
      // audit trail. The transaction in reserve.js protects against two people
      // at once; it does nothing against one person choosing to rewind it.
      //
      // So: strictly monotonic, enforced here where it cannot be bypassed. One
      // document per kind rather than one document with a field per kind
      // because rules cannot compare a dynamically-named field — splitting the
      // path is what makes the guarantee expressible at all.
      //
      // Only writers reserve ids, because only writers create records. An
      // auditor bumping a counter cannot forge a record, but it would burn a
      // reference number out of a sequence that is quoted to a regulator.
      match /docSeq/{kind} {
        allow read: if isApprovedMemberOf(orgId);
        allow create: if isWriterOf(orgId)
          && request.resource.data.keys().hasOnly(['n'])
          && request.resource.data.n is int
          && request.resource.data.n > 0;
        allow update: if isWriterOf(orgId)
          && request.resource.data.keys().hasOnly(['n'])
          && request.resource.data.n is int
          && request.resource.data.n > resource.data.n;
        allow delete: if false;
      }

      // ── The legacy reference-number counters ────────────────────────────────
      // Same guarantee as /docSeq above, for the three counters that never
      // moved onto it: `meta/stats` holds `nextSeq` for IRA- incident
      // references (incidents/lib/incidents.js), `meta/illness` the same for
      // ILL- illness ones, and `meta/counters` holds `permitSeq` — the number
      // printed on a permit to work and quoted in its audit trail
      // (ptw/lib/firestore.js nextPermitNo).
      //
      // They were covered only by the generic rule below, whose structuralOnly()
      // excludes auditLogs, defectLocks, docSeq and meta/cryptoKeys — but not
      // meta/stats. So any approved member could
      // `setDoc(.../meta/stats, {nextSeq: 1}, {merge: true})` and rewind the
      // sequence, handing the next incident a reference already printed on a
      // closed report and quoted to a regulator. The same write zeroes the
      // dashboard totals that share the document.
      //
      // The rule docSeq gets cannot be reused verbatim: meta/stats also carries
      // the module's roll-up counters, so `hasOnly(['n'])` is wrong here. What
      // has to hold is only that the sequence never moves backwards.
      // `.get('nextSeq', 0)` on both sides because most writes to this document
      // are stats deltas that do not mention nextSeq at all, and reading an
      // absent field directly raises — which denies.
      match /meta/{kind} {
        // notKeyset on READ as well as on the writes, and this is the whole
        // reason to say so out loud: before `col != 'meta'` was added to
        // structuralOnly, the keyset was refused by genericReadable →
        // structuralOnly → notKeyset. Excluding the collection from
        // structuralOnly moved every meta grant here, so a read rule without
        // notKeyset does not "keep" the old behaviour — it silently GRANTS what
        // the old rule refused, to every approved member including the outside
        // auditor, and `list` on /meta would sweep the keyset up with the
        // counters. tests/cryptoKeys.rules.test.js pins both.
        allow read: if isApprovedMemberOf(orgId) && notKeyset('meta', kind);
        allow create: if isWriterOf(orgId) && notKeyset('meta', kind);
        allow update: if isWriterOf(orgId)
          && notKeyset('meta', kind)
          && request.resource.data.get('nextSeq', 0) >= resource.data.get('nextSeq', 0)
          && request.resource.data.get('permitSeq', 0) >= resource.data.get('permitSeq', 0);
        allow delete: if false;
      }

      // Generic module data (incidents, assessments, permits, inspections,
      // extinguishers, meetings, meta/stats, sites, …). Approved members
      // read/create/update; managers+ delete. auditLogs is excluded so it keeps
      // its append-only rule above.
      // Site-scoped reads for the document library. Writes stay with the generic
      // rule below; only `read` is narrowed here.
      //
      // This is only worth anything because `documents` is excluded from the
      // generic read below. Rules are a permissive union: a second match that
      // still granted read would make every line of this one decorative.
      match /documents/{docId} {
        allow read: if canReadDocument(orgId, resource.data);
      }

      // ── Health records ──────────────────────────────────────────────────────
      // Injuries and illnesses carry special-category data: a named colleague's
      // body parts, injury type, medication, days off, the agent they were
      // exposed to, the health issue. All of it was scoped to the tenant and to
      // nothing within it — every approved member could list every colleague's
      // medical detail, and so could the auditor, who is typically an outside
      // party given a login to inspect the safety record.
      //
      // isManagerOf, NOT isElevatedOf: that helper includes 'auditor', and an
      // outside reviewer confirming injuries are recorded and verified does not
      // need to read what medication a named person is on.
      //
      // Reads nothing off the document on purpose. A per-person branch — "you
      // may read your own" — would have to test a field on the queried
      // document, and a field access in an `allow read` raises on any record
      // written before that field existed, which denies; the fix would need a
      // backfill before it could ship, and the same access decision would then
      // be spread across two mechanisms. Whoever the record is about reads it
      // through the incident it belongs to, which they are already party to.
      //
      // Worth anything only because both collections are excluded from the
      // generic read below, and from its recursive wildcard. Rules are a
      // permissive union: one surviving grant makes every line of this
      // decorative.
      match /injuries/{injuryId} {
        allow read: if isManagerOf(orgId);

        // The attached FILES, not just the fields.
        //
        // The split above moved the clinical fields here and left the DOCUMENTS
        // behind in incidents/{id}/photos, filed as kind:'medical_record' — a
        // subcollection the generic {sub=**} at the foot of this file hands to
        // every approved member AND to the external auditor, by get and by
        // list. A GP letter, a fit note, a discharge summary IS the record; the
        // fields were confined and the scan of the same information was not, so
        // one getDocs on an incident's photos returned filename, caption and a
        // download URL for every medical document in the tenant.
        //
        // A `kind` field could never have fixed that. Rules cannot filter WHICH
        // documents a list returns — a query is allowed or refused whole — so
        // the boundary has to be the collection itself, not a label on rows
        // inside a shared one.
        //
        // Nested under /injuries rather than given a top-level name of its own,
        // deliberately: `col` binds to 'injuries' for this entire subtree, and
        // 'injuries' is ALREADY excluded from the generic read below and from
        // its recursive wildcard. A new top-level collection would have to be
        // added to both of those lists, and one added to one list is the hole
        // shipped. This way there is nothing to remember. The doc id is
        // `${incidentId}__${personId}` (src/modules/incidents/lib/injuries.js),
        // so the path itself carries the person the record belongs to.
        //
        // isManagerOf, not isElevatedOf — the same reason as the injury record
        // it hangs off: 'auditor' is an outside party, and confirming injuries
        // are recorded does not require reading a named colleague's discharge
        // summary.
        //
        // Reads nothing off the document, for the reason given above: a field
        // access here raises on any pointer written before that field existed,
        // and a raising rule denies.
        //
        // WRITES are intentionally absent. The generic rule below already grants
        // create/update to isWriterOf under col == 'injuries' (so the member
        // filling in Step 1a can attach the letter they cannot read back, and
        // the auditor is refused) and restricts delete to isManagerOf, which
        // mirrors canDeleteFrom in storage.rules. Adding a write match here
        // could only widen that — rules are a permissive union.
        match /records/{recordId} {
          allow read: if isManagerOf(orgId);
        }
      }

      match /illnesses/{illnessId} {
        allow read: if isManagerOf(orgId);

        // The attachments, which /injuries got and this did not. Rules do not
        // cascade into subcollections, so the manager grant above stopped at the
        // illness document: .../illnesses/{id}/files fell through to the generic
        // recursive rule, where genericReadable() excludes col == 'illnesses' —
        // and a collection excluded from the only rule that could grant it is a
        // collection nobody can read. subscribeIllnessFiles
        // (src/modules/incidents/lib/illnesses.js) queries exactly this path, so
        // every occupational-illness attachment failed permission-denied for all
        // four roles, including the managers the record is FOR. It failed
        // closed, which is why it leaked nothing and why nothing caught it.
        //
        // isManagerOf, not isElevatedOf, for the reason /injuries/{id}/records
        // gives: 'auditor' is an outside party, and confirming illnesses are
        // recorded does not require reading a named colleague's GP letter.
        //
        // Writes stay absent, exactly as they do under /injuries: the generic
        // rule already grants create/update to isWriterOf under col ==
        // 'illnesses' and restricts delete to isManagerOf, and a match here
        // could only widen that — rules are a permissive union.
        match /files/{fileId} {
          allow read: if isManagerOf(orgId);
        }
      }

      // ── Notification ledger ─────────────────────────────────────────────────
      // sendOnce() (functions/lib/notify.js) claims a document here before every
      // send, and the claim carries the recipient's uid and the SUBJECT LINE. A
      // subject names a person and an event — an injury or illness notification
      // reprints exactly the detail the two rules above exist to contain, in a
      // collection nobody thought of as health data. It was readable by every
      // approved member, auditor included.
      //
      // Nothing on the client reads this. It is written only by the Admin SDK,
      // which bypasses rules entirely, so denying outright costs the app
      // nothing — there is no role to pick.
      //
      // `if false` rather than a test on the document: it refuses a LIST as
      // flatly as a GET, and it cannot raise on a ledger row written before a
      // field existed. A defensive .get() would have stopped the rule
      // constraining list queries, which is the shape that leaks a collection.
      //
      // Worth anything only because 'notifications' is excluded from the generic
      // read below AND from its recursive wildcard. Rules are a permissive
      // union: one surviving grant makes this line decorative.
      match /notifications/{notificationId} {
        allow read: if false;
      }

      // ── Third-party credentials ─────────────────────────────────────────────
      //
      // integrations/metabase holds the API key ODIN queries the analytics
      // warehouse with. That key is a bearer token for every question and every
      // database the Metabase instance can reach — a far wider grant than
      // anything else in this tenant — so it is admin-only on both sides, and
      // 'integrations' is excluded from the generic rule below so this is the
      // only grant that reaches it.
      //
      // Nothing in the app reads this document to USE it. The settings screen
      // reads it back through a callable that strips the key first
      // (functions/lib/metabase.js redactConfig), and the query runs
      // server-side with the Admin SDK. The admin read allowed here is the
      // fallback for a support session with the console open, not the product
      // path — which is why an admin holding it is acceptable and a member
      // holding it would not be.
      //
      // The key is stored, not hashed, because it has to be REPLAYED to
      // Metabase on every query; there is no version of this that keeps it
      // one-way. What that costs is bounded by who can reach the document, and
      // the answer is: an admin of this organization, and the functions
      // service account.
      match /integrations/{integrationId} {
        allow read, write: if isAdminOf(orgId);
      }

    // ── The generic collection gate, in one place ────────────────────────────
    //
    // Below, `match /{col}/{docId}` and its nested `match /{sub=**}` both grant
    // the same three operations, and the exclusion list for each was written
    // out INLINE IN BOTH — eight copies of a conjunct chain that has to agree
    // with itself to mean anything.
    //
    // It had already stopped agreeing. `delete` excluded auditLogs and docSeq
    // but not defectLocks, while `read` and `create/update` excluded all three;
    // defectLocks survived only because its own match block above grants the
    // delete separately. That is the failure mode of a list kept in eight
    // places: not a dramatic hole, a quiet asymmetry nobody can see because the
    // two copies are forty lines apart.
    //
    // These two functions ARE that list. Write and delete share one predicate
    // because they exclude the same set; read adds to it. The difference is
    // deliberate and load-bearing, so it is stated rather than left to be
    // inferred by diffing two long lines:
    //
    //   structural   auditLogs (append-only), defectLocks (create-only, because
    //                the create failing on an existing document IS the duplicate
    //                check) and docSeq (monotonic). A generic write would defeat
    //                each of those guarantees, so all three are excluded from
    //                every operation.
    //   read         structural, PLUS the four confidential collections —
    //                documents, injuries, illnesses, notifications — each of
    //                which has its own narrower read rule above.
    //   write        structural only. The confidential four are deliberately NOT
    //                excluded: a writer must be able to attach a record they are
    //                not entitled to read back.
    //   delete       structural only.
    //
    // delete previously omitted defectLocks from its list. Adding it takes away
    // nothing: the defectLocks block above already grants delete to
    // isWriterOf(orgId), which is a superset of the isManagerOf(orgId) this
    // generic rule paired it with. The asymmetry closes without a permission
    // moving.
    //
    // Changing one of these changes both match blocks at once, which is the
    // entire point. tests/firestore.rules.test.js is what proves it.
    function structuralOnly(col, docId) {
      return col != 'auditLogs' && col != 'defectLocks' && col != 'docSeq'
        // 'meta' joins them, and for the same reason docSeq did: /meta/{kind}
        // now carries a monotonic rule of its own, and a narrow match cannot
        // restrict anything while this one still grants the same write. The
        // reference-number counters live in meta/stats and meta/illness, and a
        // counter that can move BACKWARDS hands the next incident a reference
        // already printed on a closed report. See the /meta/{kind} block.
        //
        // This supersedes notKeyset for the generic path — excluding the whole
        // collection excludes meta/cryptoKeys with it — but the call stays,
        // because notKeyset is what the /meta/{kind} rule itself uses to keep
        // the keyset out, and deleting it here would leave that meaning
        // unstated in the place a reader looks first.
        && col != 'meta'
        // 'integrations' holds third-party CREDENTIALS — today the Metabase API
        // key ODIN queries through, which is a bearer token for an entire
        // analytics warehouse. The generic rule grants read and write on any
        // collection to any approved member, so leaving it in scope would hand
        // that key to every employee and to the outside auditor, by one getDoc.
        // Excluded from every operation, not just read: a member who could
        // WRITE it could point the connector at an instance they control and
        // collect whatever the next admin types beside it.
        //
        // The narrow admin-only match for it lives above. Rules are a
        // permissive union, so this exclusion is the load-bearing half — that
        // match restricts nothing while this one still grants the same access.
        && col != 'integrations'
        && notKeyset(col, docId);
    }
    function genericReadable(col, docId) {
      return structuralOnly(col, docId)
        && col != 'documents' && col != 'injuries' && col != 'illnesses'
        && col != 'notifications';
    }

    // A document's classification is enforced on READ and was unprotected on
    // WRITE, so any member who could legitimately reach a restricted document —
    // via their own site access — could publish it org-wide, and any member who
    // learned a document id could overwrite one they cannot read. A
    // classification the classified party can remove is advisory.
    //
    // Elevated roles set and change it; everyone else must leave all four
    // fields exactly as they are. A CREATE has no prior state to preserve, so
    // it is unaffected: the label is chosen once and then frozen against
    // ordinary members.
    function keepsClassification(col) {
      return col != 'documents'
        || resource == null
        // .get(f, '') on BOTH sides: a document written before a field existed
        // does not carry it, and reading it directly raises — a raising rule
        // denies, which would refuse every edit to older documents rather than
        // protecting a label they never had. Safe here in a way it would not be
        // on a read: this is a write condition, so nothing about list-query
        // constraining applies.
        //
        // The list below must be the list reachesSite() and canReadDocument()
        // actually DECIDE on. It was not. It froze visibility, level, siteId and
        // `region` — but the rule grants site access on siteRegion and
        // siteEntity, which are different fields (classification.js writes all
        // three separately) and were left writable, while `region` is a display
        // field no rule reads. So the freeze guarded the labels that decide
        // nothing and left the two that decide everything open: a plain member
        // could PUT siteRegion: 'their own region' onto a document filed at a
        // site they have no grant for — an update needs no read permission, so
        // it worked on documents they had never been able to open — and then
        // read it. Relabel, then read.
        //
        // Any new field reachesSite() consults has to be added here in the same
        // change, or it reopens exactly this.
        || request.resource.data.get('visibility', '') == resource.data.get('visibility', '')
        && request.resource.data.get('level', '') == resource.data.get('level', '')
        && request.resource.data.get('siteId', '') == resource.data.get('siteId', '')
        && request.resource.data.get('region', '') == resource.data.get('region', '')
        && request.resource.data.get('siteRegion', '') == resource.data.get('siteRegion', '')
        && request.resource.data.get('siteEntity', '') == resource.data.get('siteEntity', '');
    }

      match /{col}/{docId} {
        // defectLocks joins auditLogs in being excluded: its whole purpose is
        // that a create fails on an existing document, which a generic update
        // permission would quietly defeat. docSeq likewise: its monotonic rule
        // above is the guarantee, and a generic update would erase it.
        //
        // `read` is split out from create/update for one reason: documents are
        // read through the site-scoped rule above and written through this one.
        allow read: if genericReadable(col, docId) && isApprovedMemberOf(orgId)
          && moduleAllowed(orgId, col);
        // The manager gate lives INSIDE this rule rather than in a new match of
        // its own. Rules are a permissive union: a narrow per-collection match
        // restricts nothing while this one still grants the same write, so the
        // alternative was excluding a dozen collections here and again below —
        // a list nobody would keep correct. One conjunct covers every
        // collection, and adding a module cannot forget it.
        //
        // Site registry: every module's scoping and every site-level document's
        // visibility snapshot resolve through it, so renaming or deleting a site
        // reaches much further than the row it edits. `site.manage` is manager
        // in can(); this is that, enforced.
        allow create, update: if structuralOnly(col, docId)
          && isWriterOf(orgId)
          && moduleAllowed(orgId, col)
          && (isElevatedOf(orgId) || keepsClassification(col))
          && (isManagerOf(orgId)
              || (col != 'sites' && keepsDecision(col, beforeData(), request.resource.data)));
        // Delete is deliberately NOT gated on the entitlement. Turning a module
        // off should stop it being used, not trap the data already in it — an
        // operator who disables a module must not leave a tenant unable to
        // remove their own records.
        allow delete: if structuralOnly(col, docId) && isManagerOf(orgId);

        // Nested subcollections (e.g. incidents/{id}/photos).
        // The recursive wildcard also matches the parent {col}/{docId} itself, so
        // it must repeat the auditLogs guard — otherwise it would silently reopen
        // updates/deletes on the append-only audit trail. The same applies to
        // defectLocks, whose create-only rule is the duplicate check, to
        // documents, whose site scoping this would otherwise hand straight back,
        // and to the manager gate above, which this would otherwise hand back
        // for the parent document of every gated collection.
        match /{sub=**} {
          allow read: if genericReadable(col, docId) && isApprovedMemberOf(orgId)
            && moduleAllowed(orgId, col);
          allow create, update: if structuralOnly(col, docId)
            && isWriterOf(orgId)
            && moduleAllowed(orgId, col)
            && (isElevatedOf(orgId) || keepsClassification(col))
            && (isManagerOf(orgId)
                || (col != 'sites' && keepsDecision(col, beforeData(), request.resource.data)));
          allow delete: if structuralOnly(col, docId) && isManagerOf(orgId);
        }
      }
    }
  }
}
