# Notification email goes out through the Brevo SMTP relay. The From address
# stays info@weehs.org. Brevo must have that domain verified or it will refuse
# the message. Do not point MAIL_FROM at a different address.
#
#   From:    EHS notifications <info@weehs.org>
#   SMTP:    smtp-relay.brevo.com:587 (STARTTLS)
#   User:    the Brevo SMTP login, not the From mailbox
#   Links:   https://suite.weehs.org
#
# The SMTP key is not a default and must not be written here. It is stored
# as a secret:
#
#   firebase functions:secrets:set SMTP_PASS
#
# The emulator reads it from functions/.secret.local:
#
#   SMTP_PASS=the-brevo-smtp-key
#
# Until SMTP_USER is the Brevo login and that secret is the real key, the
# triggers log an error and do not send. The write that raised the record
# still succeeds. See DEPLOYMENT.md §6.

# Uncomment only to override the relay above.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=the-brevo-smtp-login
# MAIL_FROM=EHS notifications <info@weehs.org>
# APP_ORIGIN=https://suite.weehs.org

# WhatsApp site lookup (Meta Cloud API). Off by default. The three secrets are
# set with `firebase functions:secrets:set` (WA_APP_SECRET, WA_ACCESS_TOKEN,
# WA_VERIFY_TOKEN) and the emulator reads them from functions/.secret.local.
# WA_ENABLED=false
# WA_PHONE_NUMBER_ID=
# WA_GRAPH_VERSION=v25.0
# WA_DISPLAY_NUMBER=
# WA_DAILY_CAP=2000
# Optional `name+lang`. Leave unset to send free-form text.
# WA_TEMPLATE_WELCOME=
# WA_TEMPLATE_TEST=

# Password-change completion. Identity Toolkit checks the current password;
# the Admin SDK sets the new one. This is a web API key Identity Toolkit
# accepts from Cloud Functions — not the browser key locked to hosting
# referrers, which the function cannot present. Empty refuses the completion
# and leaves mustChangePassword set. The Auth emulator does not need it.
# Do not deploy the rules that block a client clear of that flag until a
# completion against this key has succeeded. Not a secret; still do not commit
# a real value.
# AUTH_WEB_API_KEY=
