{
  "name": "ohsms",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "OHS Management System — unified Occupational Health & Safety platform (incidents, HIRA, inspections, audits, permit-to-work, LOTO, fire marshal, HSE committee, training, documents/SDS).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "emulators": "firebase emulators:start",
    "emulators:rules": "node scripts/reload-emulator-rules.mjs",
    "seed": "node scripts/seed.mjs",
    "dev:full": "concurrently -k -n emu,web -c magenta,cyan \"npm:emulators\" \"npm:dev\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:rules": "node scripts/rules-preflight.mjs",
    "test:rules": "firebase emulators:exec --only firestore,storage --config firebase.rulestest.json \"vitest run --config vitest.rules.config.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/inter": "^5.0.18",
    "@sentry/browser": "^10.69.0",
    "@xyflow/react": "^12.0.4",
    "date-fns": "^3.6.0",
    "firebase": "^10.12.4",
    "framer-motion": "^11.3.19",
    "html-to-image": "^1.11.11",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lottie-react": "^2.4.0",
    "lucide-react": "^0.417.0",
    "papaparse": "^5.4.1",
    "qrcode": "^1.5.4",
    "qrcode.react": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-leaflet": "^4.2.1",
    "react-leaflet-cluster": "^2.1.0",
    "react-router-dom": "^6.26.0",
    "react-to-print": "^2.15.1",
    "recharts": "^2.12.7",
    "three": "^0.185.1",
    "xlsx": "^0.18.5"
  },
  "overrides": {
    "undici": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.0",
    "@firebase/rules-unit-testing": "^3.0.4",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.9",
    "firebase-tools": "^13.15.1",
    "globals": "^15.9.0",
    "jsdom": "^24.1.1",
    "postcss": "^8.4.40",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.7",
    "vite": "^5.3.5",
    "vitest": "^2.0.5"
  }
}
