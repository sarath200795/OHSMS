// ─────────────────────────────────────────────────────────────────────────────
// Cloud Storage — tenant-isolated.
//
// This closes SECURITY.md S-01. Until this ruleset, {orgId} was captured in the
// path and checked against nothing, so any signed-in user of any tenant could
// read and delete any other tenant's uploaded files if they knew the path —
// incident photos, permit documents, LOTO procedure photos, training content.
//
// It reads the organization off the ID TOKEN, because that is the only thing a
// Storage rule can learn about the caller: Storage rules cannot query Firestore.
// functions/index.js (syncUserClaims) puts it there, and only for an APPROVED
// member — a pending joiner's profile already names an org, since that is what
// the waiting room is, so minting a claim from it would let anyone sign up
// naming a tenant and read its files at once.
//
// An earlier draft used firestore.get(), which needs cross-service rules
// granted on the project and costs a document read on every file operation.
// The claim is better on both counts: nothing to grant, nothing to bill, and
// the check is local to the request.
//
// Verified against the emulator in tests/storage.rules.test.js, which mints
// tokens carrying the same claims syncUserClaims stamps — so the token shapes
// under test are the real ones.
//
// The path is built by storagePath() in src/shared/storage/index.js as
// `orgs/<orgId>/<kind>/<rand>-<file>`. It sanitises every segment, but only by
// replacing characters outside [A-Za-z0-9_-], and a Firestore auto-id is
// alphanumeric — so the org segment is byte-identical to the claim it is
// matched against. If that sanitiser ever starts folding case, this rule stops
// matching and every upload fails closed.
// ─────────────────────────────────────────────────────────────────────────────
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // No claim means no org, and no org matches any path segment — so an
    // unstamped, revoked or pending user fails closed. That is the mechanism.
    //
    // .get() rather than .orgId: reading an absent claim directly raises
    // "Property orgId is undefined on object". An erroring rule denies, so the
    // outcome was right either way, but it denied by accident rather than by
    // decision and filled the logs with evaluation errors for every signed-in
    // user who had not been stamped yet. (The direct-field-access rule that
    // matters in firestore.rules is about constraining LIST queries; Storage
    // has no such queries, so nothing here is weakened by reading it safely.)
    function inOrg(orgId) {
      return request.auth != null && request.auth.token.get('orgId', '') == orgId;
    }

    // Role rides on the same token as orgId (functions/lib/claims.js CLAIM_KEYS),
    // and until now this file never read it — so both enforcement surfaces
    // disagreed about the same person. Firestore refuses an auditor every write
    // (isWriterOf) and requires a manager to delete (isManagerOf); Storage let
    // any member of the org delete anything in it. The files ARE the evidence —
    // incident photos, permit documents, isolation procedure photos, drill
    // evidence — and the auditor is described in firestore.rules as an outside
    // party given a login to inspect the safety record. Deleting is
    // unrecoverable and leaves nothing in the audit trail, which only records
    // what the app chose to write.
    function myRole() {
      return request.auth != null ? request.auth.token.get('role', '') : '';
    }

    // Mirrors isWriterOf: an auditor reads the record, never edits it.
    function canWriteTo(orgId) {
      return inOrg(orgId) && myRole() != 'auditor';
    }

    // Mirrors isManagerOf. A token stamped before role was a claim yields '',
    // which is not in this list — so a stale session loses the medical-record
    // read rather than keeping it, and gets it back on the next sign-in
    // (AuthContext forces getIdToken(true), and sessions do not outlive the
    // browser session). Failing closed is the right direction here.
    //
    // It gates ONE thing now: reading a medical record, below. It used to gate
    // deleting as well, until deletion moved to the deleteOrgFile callable and
    // canDelete() became an unconditional refusal. Kept as a named predicate
    // rather than inlined, because `in ['admin','manager']` appearing in the
    // rule body is how the second copy starts.
    function isManagerIn(orgId) {
      return inOrg(orgId) && myRole() in ['admin', 'manager'];
    }

    // NO CLIENT MAY DELETE. Deletion moved to the `deleteOrgFile` callable
    // (functions/lib/fileDelete.js), and this refusal is what makes that the
    // only route rather than merely the polite one.
    //
    // Why it could not stay here. A Storage rule cannot query Firestore, so it
    // can only read the org and role the caller's ID TOKEN claims — and a token
    // stays valid until it expires, up to an hour. Stripping the claim does not
    // reach back into a token already issued, and revoking refresh tokens does
    // not either, because rules never consult tokensValidAfterTime. So a
    // manager suspended, demoted or moved to another tenant kept the ability to
    // destroy that organization's evidence for the rest of the hour
    // (SECURITY.md S-19). Deleting is irreversible, the files ARE the evidence,
    // and none of it reaches the audit trail.
    //
    // The obvious fix — a cross-service firestore.get() on the live profile,
    // right here — was written and reverted. THE STORAGE EMULATOR DOES NOT
    // EVALUATE CROSS-SERVICE CALLS: it denies firestore.get()/exists() outright
    // instead of resolving them. A minimal probe confirmed it. So the rule
    // could not be tested at all, in the one file that is the only enforcement
    // boundary this app has — and while it was in place every refusal test
    // still passed, because everything was refusing. That is S-17 again.
    //
    // The callable reads the profile LIVE on every request and runs under the
    // functions test suite, so the control is both current and exercised.
    //
    // It takes no orgId. It used to, and ignored it — a parameter that reads
    // like the refusal is scoped to one tenant when it is absolute. Dropping it
    // makes the signature say what the body does.
    function canDelete() {
      return false;
    }

    // Medical records are excluded from the read below and granted narrowly
    // underneath. The exclusion is the load-bearing half: this file is a
    // permissive union exactly like firestore.rules, so a narrower match added
    // on its own would restrict nothing — the generic `inOrg` here would still
    // hand the bytes to every member of the tenant and to the auditor, and the
    // new match would be decorative. `kind` is a single path SEGMENT, so this
    // comparison works; the Firestore side could not do the same because its
    // {sub=**} captures a whole Path the rules language cannot compare, which
    // is why the pointers had to move collection instead.
    //
    // Only `read` is excluded, deliberately. create/update/delete below already
    // say the right thing for this prefix — an auditor cannot upload, nothing
    // may be overwritten in place, and only a manager may delete — so adding
    // `kind != 'medical-records'` to any of them would break the upload rather
    // than tighten it.
    match /orgs/{orgId}/{kind}/{fileName} {
      allow read: if inOrg(orgId) && kind != 'medical-records';

      // `resource == null` is what actually prevents an overwrite, and it is
      // here because the emulator proved the obvious version does not work:
      // `allow update: if false` did NOT stop an upload onto an existing path,
      // because Storage evaluated that upload as a CREATE. An earlier version
      // of this file carried a comment claiming update-denial closed that
      // vector. It did not. Nothing legitimately overwrites — storagePath()
      // prefixes 8 random bytes — so denying it outright costs nothing and
      // stops evidence being replaced in place.
      allow create: if canWriteTo(orgId)
        && resource == null
        && request.resource.size < 20 * 1024 * 1024;

      allow update: if false;

      allow delete: if canDelete();
    }

    // The bytes behind a medical record — a GP letter, a fit note, a discharge
    // summary — read by the same people who may read the pointer to it.
    //
    // A pointer nobody can read is worth nothing while the file behind it is
    // readable by anyone in the tenant. These used to be uploaded under the
    // `incident-photos` kind, byte-identical in path to a photograph of a
    // damaged guard rail and so impossible to tell apart by any rule; they now
    // get their own kind, which is what makes them addressable here at all.
    //
    // isManagerIn mirrors isManagerOf, the predicate that gates
    // /injuries/{id}/records in firestore.rules. The two surfaces must agree
    // about the same person or the weaker one is the real answer — which is the
    // lesson from HIGH-1, where Firestore required a manager to delete and this
    // file let any member do it.
    //
    // No create rule, no delete rule: the generic match above already covers
    // this path (`kind` binds to 'medical-records') with exactly the terms
    // wanted — isWriterOf-equivalent create with the overwrite guard and the
    // 20 MB cap, update denied, delete manager-only. A second create grant here
    // could only widen them.
    match /orgs/{orgId}/medical-records/{fileName} {
      allow read: if isManagerIn(orgId);
    }

    // Everything else is closed. New areas get their own explicit match rather
    // than inheriting one written for a different purpose.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
