# ─────────────────────────────────────────────────────────────────────────────
# OHS MS environment
#
# LOCAL DEVELOPMENT (recommended): use the Firebase Emulator Suite.
#   1. Copy this file to `.env`
#   2. Leave VITE_USE_EMULATORS=true and keep the demo project id below
#   3. Run:  npm run dev:full        (starts emulators + Vite together)
#      or:   npm run emulators       (in one terminal)
#            npm run dev             (in another)
#   No real Firebase project or keys are needed to develop against emulators.
#
# CONNECTING TO A REAL FIREBASE PROJECT:
#   Set VITE_USE_EMULATORS=false and fill in the VITE_FIREBASE_* values from
#   your Firebase console → Project settings → Your apps → Web app config.
# ─────────────────────────────────────────────────────────────────────────────

# Point the app at local emulators (true) or a real Firebase project (false).
VITE_USE_EMULATORS=true

# Firebase web config. With emulators, apiKey/projectId just need to be present;
# the demo project id below works out of the box with `firebase emulators:start`.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=ohsms-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ohsms-demo
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Emulator host/ports (defaults match firebase.json).
VITE_EMULATOR_HOST=127.0.0.1
VITE_EMULATOR_AUTH_PORT=9099
VITE_EMULATOR_FIRESTORE_PORT=8080

# ─────────────────────────────────────────────────────────────────────────────
# Nearest emergency services (Emergency Response → Refresh nearest services)
#
# Optional. Without a key the lookup uses OpenStreetMap, which is free but
# patchy: it often has no phone number for a station, and its police/fire
# entries are sometimes mis-tagged. With a key, Google Places is used instead —
# curated names and a phone number for most stations.
#
# Setup: Google Cloud console → enable "Places API (New)" → create an API key →
# restrict it to your hosting domain (HTTP referrers) AND to the Places API.
# Billing must be enabled on the project. The key ships in the client bundle,
# so the referrer restriction is what protects it — do not leave it unrestricted.
# ─────────────────────────────────────────────────────────────────────────────
VITE_GOOGLE_MAPS_API_KEY=

# ── Production hardening (all optional; features stay off until set) ──────────
# App Check: reCAPTCHA v3 site key registered in Firebase console → App Check.
# Client wiring activates when set; enforcement is turned on in the console.
VITE_APPCHECK_SITE_KEY=
# Lets local dev talk to an App-Check-enforced project (console → debug tokens).
VITE_APPCHECK_DEBUG_TOKEN=
# Error monitoring. When set, crashes and unhandled rejections ship to Sentry.
VITE_SENTRY_DSN=
# Storage emulator port (matches firebase.json).
VITE_EMULATOR_STORAGE_PORT=9199

# ── Storage & database backends (portability seams) ───────────────────────────
# Firebase Storage bucket. Leave blank to derive `<projectId>.firebasestorage.app`
# (new projects). Older projects use `<projectId>.appspot.com` — copy the exact
# value from Firebase console → Storage if uploads fall back to inline files.
VITE_FIREBASE_STORAGE_BUCKET=
# File storage driver: firebase (default) | s3. See src/shared/data/README.md.
VITE_STORAGE_DRIVER=firebase
# s3 driver only: your presign endpoint (contract in src/shared/storage/adapters/s3.js).
VITE_S3_PRESIGN_ENDPOINT=
# Database driver: firestore (default). Adapters in src/shared/data/adapters/.
VITE_DATA_DRIVER=firestore

# Firestore persistent offline cache. OFF by default: when a listener cannot
# connect, a persistent cache serves an EMPTY snapshot instead of erroring, so
# lists render blank and read as data loss. Turn on per environment only after
# watching a bad-network session behave.
VITE_OFFLINE_CACHE=false
