# Response headers for the Cloudflare deploy (wrangler.jsonc). This mirrors
# hosting.headers in firebase.json; a change to one belongs in both, or the
# two hosts serve the app under different security policy.
#
# Cloudflare merges every matching block, joining duplicate header names, so
# the narrower blocks below detach the catch-all Cache-Control with
# "! Cache-Control" before setting their own.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(self), payment=()
  Strict-Transport-Security: max-age=86400
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.gstatic.com https://www.google.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.googleapis.com https://*.gstatic.com https://*.googleusercontent.com https://*.firebasestorage.app https://tile.openstreetmap.org https://*.tile.openstreetmap.org; connect-src 'self' https://www.google.com https://www.recaptcha.net https://*.cloudfunctions.net https://*.run.app https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://*.firebasestorage.app https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://nominatim.openstreetmap.org https://overpass-api.de https://overpass.kumi.systems https://overpass.private.coffee https://overpass.openstreetmap.fr https://lz4.overpass-api.de https://maps.mail.ru https://maps.googleapis.com https://*.ingest.sentry.io https://*.ingest.us.sentry.io; frame-src https://www.google.com https://www.recaptcha.net; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Cache-Control: no-cache

# Vite's content-hashed bundles. Only these are immutable: an unhashed file
# such as runtime-config.js cached for a year would pin a stale config.
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/health.json
  ! Cache-Control
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/json; charset=utf-8

/manifest.webmanifest
  Content-Type: application/manifest+json

/store.json
  Content-Type: application/json; charset=utf-8

/downloads/*.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment
