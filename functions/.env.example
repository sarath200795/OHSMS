# Assignment email for the Cloud Functions in this package.
#
# Copy to functions/.env (gitignored). Do not put SMTP_PASS in this file or in
# .env — it is a Secret Manager secret. A mail password in the function
# environment is the finding recorded as LOW-13.
#
#   firebase functions:secrets:set SMTP_PASS
#
# The emulator reads that password from functions/.secret.local:
#
#   SMTP_PASS=the-value
#
# Until SMTP_HOST, MAIL_FROM and SMTP_PASS are all set, the triggers log an
# error and do not send. The assignment write itself still succeeds.
# See DEPLOYMENT.md §6.

# SMTP server. Required to send.
SMTP_HOST=

# Defaults to 587 when unset or not a port. 465 turns on implicit TLS.
SMTP_PORT=587

# Optional. Sent as the SMTP username when set.
SMTP_USER=

# From header: safety@example.com or WEHS <safety@example.com>
MAIL_FROM=

# Absolute origin of the deployed app, no path. Links in the mail are this
# plus /incidents/{id}, /incidents/illness/{id}, /mock-drills or /training/my.
# Optional. Without it the mail names the in-app path and does not build a URL.
APP_ORIGIN=
