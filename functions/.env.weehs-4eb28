# Non-secret Firebase params for CI / non-interactive deploy.
# Secrets DATA_KEY_MASTER and SMTP_PASS live in Secret Manager only — never put them here.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# Brevo SMTP login. Not the From address. Set before a deploy that should send.
SMTP_USER=
MAIL_FROM=EHS notifications <info@weehs.org>
APP_ORIGIN=https://suite.weehs.org
