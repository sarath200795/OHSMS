# Non-secret Firebase params for CI / non-interactive deploy.
# Secrets DATA_KEY_MASTER and SMTP_PASS live in Secret Manager only — never put them here.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# Brevo SMTP login. Not the From address. Set before a deploy that should send.
SMTP_USER=
MAIL_FROM=EHS notifications <info@weehs.org>
APP_ORIGIN=https://suite.weehs.org
# WhatsApp site lookup (functions/index.js). Off unless WA_ENABLED=true and the
# phone number id is set. WA_APP_SECRET, WA_ACCESS_TOKEN and WA_VERIFY_TOKEN are
# Secret Manager secrets only — never put them here.
WA_ENABLED=true
WA_PHONE_NUMBER_ID=1418439508016031
WA_GRAPH_VERSION=v25.0
WA_DISPLAY_NUMBER=+91 77939 66625
WA_DAILY_CAP=2000
# Optional `name+lang`. Empty sends free-form text. CI overwrites these from
# the WA_TEMPLATE_WELCOME and WA_TEMPLATE_TEST repository variables when set.
WA_TEMPLATE_WELCOME=
WA_TEMPLATE_TEST=
# Telegram site lookup (tgWebhook). TELEGRAM_BOT_TOKEN and TG_WEBHOOK_SECRET are
# Secret Manager secrets only — never put them here. TG_LIST_ORGS stays false
# so an open bot does not recite organisation names.
TG_ENABLED=true
TG_ORG_ID=
TG_LIST_ORGS=false
TG_DAILY_CAP=2000
# completePasswordChange. Empty refuses the check and does not clear the flag.
# Not the browser key. Set from the AUTH_WEB_API_KEY repository variable at deploy.
AUTH_WEB_API_KEY=
