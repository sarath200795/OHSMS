node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-ssr/
*.local

# Env
.env
.env.*
!.env.example
# .env.* would also hide the committed project params file CI needs.
# SMTP_PASS and DATA_KEY_MASTER stay out of git (Secret Manager only).
!functions/.env.weehs-4eb28

# Firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
firebase-export-*/
emulator-data/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.log

# Test / coverage
coverage/

# Vendored source (module repos copied in during integration)
.vendor/

# Firebase project targets & prod env (per-machine, never committed)
.firebaserc
.env.production

# Training videos. ~151 MB across four files — about 99% of everything this
# repository tracked, paid for by every clone and every CI checkout, for content
# no code imports. They stay on disk and belong in Firebase Storage or a CDN.
# Untracking does not shrink history; the existing 151 MB is still in there.
Vedio/

# Playwright artifacts
test-results/
playwright-report/

# Vitest writes these transient config snapshots next to the config file
vitest.config.js.timestamp-*

# The standalone FLS dashboard fetches raw warehouse dumps and caches an API key.
tools/fls-dashboard/raw/*.json
!tools/fls-dashboard/raw/card_*.json
tools/fls-dashboard/.mbkey
tools/fls-dashboard/data.json
tools/fls-dashboard/fls-dashboard.html

# Native shells. `cap sync` copies the built web app into the projects; those
# copies are not source. Release signing material is never committed — a
# keystore in git is a key anyone can sign as us. The Android debug keystore
# is the public debug key and may stay.
android/.gradle/
android/local.properties
android/build/
android/app/build/
android/app/src/main/assets/public/
android/capacitor-cordova-android-plugins/build/
ios/App/Pods/
ios/App/build/
ios/App/App/public/
ios/DerivedData/
*.jks
# The login page links here. The file is produced by the Android workflow and
# copied in at hosting deploy. A binary APK does not belong in git.
public/downloads/*.apk
*.keystore
!android/app/debug.keystore
android/keystore.properties
**/keystore.properties
*.p12
*.mobileprovision
*.cer

# Security documents that are deliberately NOT in this public repository:
# the operational runbook, the ISO 27001 audit reports, and the OPEN half of
# the security register. They live with the maintainer — docs/PRODUCTION.md and
# docs/ISO27001-AUDIT.md are pointer stubs explaining where and why (finding
# H-2, 2026-09-09). These patterns stop a copy being pulled back in by accident.
ohsms-private-docs/
*-private.md
SECURITY-open.md
ISO27001-Audit-Report-*.pdf
ux-ref/
