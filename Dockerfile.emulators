# Local-dev image for `docker compose`: Firebase Auth is a Node process,
# Firestore and Storage emulators are JVM processes. node:20-bookworm has
# neither firebase-tools nor a JDK, so the previous compose file — `image:
# node:20-bookworm` plus `npm install -g firebase-tools` at start — failed as
# soon as Firestore tried to boot, with an error about Java that said nothing
# about Docker.
#
# Not a production image. Hosting still ships through Firebase Hosting; this
# exists so `docker compose up` is a real one-command emulator stack.
FROM node:20-bookworm

RUN apt-get update \
 && apt-get install -y --no-install-recommends openjdk-17-jre-headless \
 && rm -rf /var/lib/apt/lists/*

# Match the firebase-tools major the repo's package.json pins, so compose and
# `npm run emulators` do not drift onto different emulator builds.
RUN npm install -g firebase-tools@13

WORKDIR /app
