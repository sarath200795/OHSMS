<?xml version="1.0" encoding="utf-8"?>
<!-- Android 7 through 11 (this app's minSdk is 24). Android 12 and later ignore
     this file and read data_extraction_rules.xml instead. allowBackup false
     already refuses backup on these versions; the excludes are here so a
     transport that still consults the rules has nothing to copy.

     WebView storage is not its own domain. Firebase local persistence
     (IndexedDB) and localStorage live under app_webview inside the private
     data directory, which is the root domain. Excluding root, not a single
     file, is what keeps that session out. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
    <exclude domain="device_file" path="." />
    <exclude domain="device_database" path="." />
    <exclude domain="device_sharedpref" path="." />
</full-backup-content>
