# Settings for selfhost/compose.yaml. Copy to .env (next to compose.yaml) and
# fill in every value. .env holds secrets: keep it off shared drives and out
# of version control, and back it up somewhere safe.
#
# Generate each random value with the command shown. Hex keeps the database
# passwords safe to put in a connection URL.

# The release to run, pinned. From the release page (docs/RELEASES.md):
# prefer the @sha256 digest form.
WEEHS_IMAGE=ghcr.io/OWNER/weehs-dedicated:2.1.0

# The name people type, with no https:// — for example ehs.example.com. Its
# DNS record must point at this server before the first start.
DOMAIN=

# Database passwords. openssl rand -hex 24
DB_ADMIN_PASSWORD=
APP_DB_PASSWORD=

# Encrypts the secrets this environment stores. Losing it loses them, and the
# app will not start with a different one. openssl rand -base64 32
STATE_KEY=

# The operator's password for filing the provisioning request. openssl rand -hex 32
CONTROL_TOKEN=

# Signs sign-in sessions. Changing it signs everyone out. openssl rand -hex 32
SESSION_SECRET=

# Wraps the keys for encrypted fields. 32 bytes, base64 (hex is refused).
# openssl rand -base64 32
DATA_KEY_MASTER=

# Optional: outgoing mail (handoff link, invites, "ready" mail). Without it,
# the handoff link is returned to the operator instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
