{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self), payment=()" },
          { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://www.gstatic.com https://www.google.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.googleapis.com https://*.gstatic.com https://*.googleusercontent.com https://*.firebasestorage.app https://tile.openstreetmap.org https://*.tile.openstreetmap.org; connect-src 'self' https://www.google.com https://www.recaptcha.net https://*.cloudfunctions.net https://*.run.app https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://*.firebasestorage.app https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://api.open-meteo.com https://nominatim.openstreetmap.org https://overpass-api.de https://overpass.kumi.systems https://overpass.private.coffee https://maps.mail.ru https://maps.googleapis.com https://*.ingest.sentry.io https://*.ingest.us.sentry.io; frame-src https://www.google.com https://www.recaptcha.net; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" },
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "**/*.@(js|css|svg|woff2|woff|ttf|ico|png|jpg|webp)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/incidents",
        "destination": "/apps/incidents/index.html"
      },
      {
        "source": "/incidents/**",
        "destination": "/apps/incidents/index.html"
      },
      {
        "source": "/hira",
        "destination": "/apps/hira/index.html"
      },
      {
        "source": "/hira/**",
        "destination": "/apps/hira/index.html"
      },
      {
        "source": "/inspections",
        "destination": "/apps/inspections/index.html"
      },
      {
        "source": "/inspections/**",
        "destination": "/apps/inspections/index.html"
      },
      {
        "source": "/audit",
        "destination": "/apps/audit/index.html"
      },
      {
        "source": "/audit/**",
        "destination": "/apps/audit/index.html"
      },
      {
        "source": "/permits",
        "destination": "/apps/ptw/index.html"
      },
      {
        "source": "/permits/**",
        "destination": "/apps/ptw/index.html"
      },
      {
        "source": "/loto",
        "destination": "/apps/loto/index.html"
      },
      {
        "source": "/loto/**",
        "destination": "/apps/loto/index.html"
      },
      {
        "source": "/equipment",
        "destination": "/apps/equipment/index.html"
      },
      {
        "source": "/equipment/**",
        "destination": "/apps/equipment/index.html"
      },
      {
        "source": "/mock-drills",
        "destination": "/apps/drills/index.html"
      },
      {
        "source": "/mock-drills/**",
        "destination": "/apps/drills/index.html"
      },
      {
        "source": "/committee",
        "destination": "/apps/committee/index.html"
      },
      {
        "source": "/committee/**",
        "destination": "/apps/committee/index.html"
      },
      {
        "source": "/training",
        "destination": "/apps/training/index.html"
      },
      {
        "source": "/training/**",
        "destination": "/apps/training/index.html"
      },
      {
        "source": "/documents",
        "destination": "/apps/documents/index.html"
      },
      {
        "source": "/documents/**",
        "destination": "/apps/documents/index.html"
      },
      {
        "source": "/emergency-response",
        "destination": "/apps/emergency/index.html"
      },
      {
        "source": "/emergency-response/**",
        "destination": "/apps/emergency/index.html"
      },
      {
        "source": "/objectives",
        "destination": "/apps/objectives/index.html"
      },
      {
        "source": "/objectives/**",
        "destination": "/apps/objectives/index.html"
      },
      {
        "source": "/weather",
        "destination": "/apps/weather/index.html"
      },
      {
        "source": "/weather/**",
        "destination": "/apps/weather/index.html"
      },
      {
        "source": "/cctv",
        "destination": "/apps/cctv/index.html"
      },
      {
        "source": "/cctv/**",
        "destination": "/apps/cctv/index.html"
      },
      {
        "source": "/stakeholder",
        "destination": "/apps/stakeholder/index.html"
      },
      {
        "source": "/stakeholder/**",
        "destination": "/apps/stakeholder/index.html"
      },
      {
        "source": "/actions",
        "destination": "/apps/actions/index.html"
      },
      {
        "source": "/actions/**",
        "destination": "/apps/actions/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions",
    "ignore": [
      "node_modules",
      ".git",
      "**/*.test.js",
      "vitest.config.js"
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true,
    "storage": {
      "port": 9199
    }
  },
  "storage": {
    "rules": "storage.rules"
  }
}
