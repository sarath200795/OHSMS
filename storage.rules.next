// ─────────────────────────────────────────────────────────────────────────────
// THE TENANT-ISOLATED STORAGE RULES. Not live yet — this file is staged.
//
// It closes SECURITY.md S-01: today any signed-in user of any tenant can read
// and delete any other tenant's uploaded files if they know the path, because
// storage.rules captures {orgId} and checks nothing against it.
//
// It reads the organization off the ID TOKEN. Storage rules cannot query
// Firestore, so a claim is the only thing available — and functions/index.js
// (syncUserClaims) puts it there, for APPROVED members only, so a pending
// joiner naming a tenant at signup gets nothing.
//
// An earlier sketch used firestore.get(), which needs cross-service rules
// granted on the project and costs a document read on every file operation.
// The claim is better on both counts: nothing to grant, nothing to bill, and
// the check is local to the request.
//
// ⚠️ SWAPPING THIS IN IS THE LAST STEP, NOT THE FIRST. A token with no orgId is
// denied by every rule here, so deploying before the claims exist locks the
// whole organization out of its own files. docs/PRODUCTION.md §4b:
//   1. deploy functions          (done)
//   2. run backfillClaims        per organization
//   3. people sign in again      (the client forces a token refresh)
//   4. replace storage.rules with this file and deploy
//
// Proven against the emulator in tests/storage.rules.test.js, which mints
// tokens carrying claims — so the behaviour below is verified, not assumed.
// ─────────────────────────────────────────────────────────────────────────────
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // No claim means no org, and no org matches any path segment — so an
    // unstamped, revoked or pending user fails closed. That is the mechanism.
    //
    // .get() rather than .orgId: reading an absent claim directly raises
    // "Property orgId is undefined on object". An erroring rule denies, so the
    // outcome was right either way, but it denied by accident rather than by
    // decision and filled the logs with evaluation errors for every signed-in
    // user who had not been stamped yet — which, during the cutover, is all of
    // them. (The direct-access rule that matters in firestore.rules is about
    // constraining LIST queries; Storage has no such queries, so nothing here
    // is weakened by reading the claim safely.)
    function inOrg(orgId) {
      return request.auth != null && request.auth.token.get('orgId', '') == orgId;
    }

    match /orgs/{orgId}/{kind}/{fileName} {
      allow read: if inOrg(orgId);

      // `resource == null` is what actually prevents an overwrite, and it is
      // here because the emulator proved the obvious version does not work:
      // `allow update: if false` did NOT stop an upload onto an existing path,
      // because Storage evaluated that upload as a CREATE. The rules this
      // replaces carry a comment claiming update-denial closed that vector; it
      // did not. Nothing legitimately overwrites — storagePath() prefixes 8
      // random bytes, so every upload lands on a fresh path — so denying it
      // outright costs the product nothing and stops evidence being replaced
      // in place.
      allow create: if inOrg(orgId)
        && resource == null
        && request.resource.size < 20 * 1024 * 1024;

      allow update: if false;

      allow delete: if inOrg(orgId);
    }

    // Everything else is closed. New areas get their own explicit match rather
    // than inheriting one written for a different purpose.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
