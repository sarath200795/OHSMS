rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// OHS MS — unified, multi-tenant Firestore security rules.
//
// Model: every organization is a tenant. A user's profile (/users/{uid}) pins
// them to one orgId with a status (pending|approved) and a role. Members only
// ever touch their own organization's data; all module data lives under
// /organizations/{orgId}/<collection>. The public /orgIndex lets signup resolve
// an org by name without reading the member-only organizations collection.
//
// Module collections vary per feature (incidents, assessments, permits,
// inspectionRecords, extinguishers, consultations, …). Rather than enumerate
// them all, a generic per-org rule grants approved members access to any
// collection EXCEPT auditLogs, which stays append-only via its own rule.
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isApprovedMemberOf(orgId) {
      return hasProfile()
        && myProfile().orgId == orgId
        && myProfile().status == 'approved';
    }

    function isAdminOf(orgId) {
      return isApprovedMemberOf(orgId) && myProfile().role == 'admin';
    }

    // Unified roles: manager is elevated (approve/close/delete), auditor is
    // read-only, member is standard. Admin is implicitly allowed everything.
    function isManagerOf(orgId) {
      return isApprovedMemberOf(orgId)
        && (myProfile().role == 'admin' || myProfile().role == 'manager');
    }

    // ── Public org-name index (no sensitive fields) ───────────────────────────
    // Maps a lowercased org name to its orgId. Publicly readable because signup
    // has to resolve "which org is this?" before the user is a member of
    // anything.
    //
    // This was `create, update: if isSignedIn()`, which made it a tenant-hijack
    // primitive: anyone who registered an account could repoint an existing
    // org's entry at their own org, and every employee who subsequently signed
    // up by name would be enrolled into the attacker's tenant instead — where
    // the attacker is admin and reads everything they go on to file. Nothing in
    // the app writes an update, so the rule was granting authority the product
    // never used.
    //
    // Create is pinned with getAfter to the registration batch that also writes
    // the caller's own profile, exactly as /users/{uid} is: at that instant the
    // profile does not exist yet, so isApprovedMemberOf cannot be used. The same
    // condition covers the self-heal backfill for pre-index orgs, where the
    // caller is already a member of the org being indexed.
    match /orgIndex/{key} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['orgId', 'name'])
        && request.resource.data.orgId is string
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId
             == request.resource.data.orgId;
      // An entry may be corrected by its own org, but never repointed elsewhere.
      allow update: if isApprovedMemberOf(resource.data.orgId)
        && request.resource.data.keys().hasOnly(['orgId', 'name'])
        && request.resource.data.orgId == resource.data.orgId;
      allow delete: if false;
    }

    // ── Public QR mirror (fire equipment) ─────────────────────────────────────
    // A minimal, publicly-readable copy of an extinguisher / AED / fire-alarm
    // device, keyed by its qrToken, so anyone scanning the QR code can view the
    // asset without signing in. Written (create/update/delete) only by an
    // approved member of the owning org — the write rides in the same batch as
    // the org-scoped asset write, so the member is already authorised there.
    // `get`, NOT `read`. In Firestore, `read` = `get` + `list`, and a wildcard
    // match with an unconditional allow grants BOTH — so `allow read: if true`
    // let an unauthenticated stranger page the entire collection and walk away
    // with every tenant's asset register. Verified against production before
    // this change: 842 documents, no credential, one curl.
    //
    // Token unguessability was the whole security model here, and listing
    // defeats it without guessing anything. The app has only ever fetched these
    // by exact token (QrLanding does getDoc(doc(db,'qr',token))), so `get`
    // alone costs nothing and `list` was authority the product never used.
    match /qr/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if isApprovedMemberOf(request.resource.data.orgId);
      allow update: if isApprovedMemberOf(resource.data.orgId)
        || isApprovedMemberOf(request.resource.data.orgId);
      allow delete: if isApprovedMemberOf(resource.data.orgId);
    }

    // Public mirror for the QR code printed on a work permit. Same shape of
    // rule as /qr above and for the same reason: whoever scans a permit taped
    // to a scaffold — a contractor, an auditor, a fire watcher — has no account
    // and must still be able to read whether it is valid right now.
    //
    // The mirror is a copy, not the permit: it carries no approvals, no
    // decisions and no attached documents, and nothing can be written back
    // through it. The token is 18 random characters, so it is unguessable and
    // is the only thing linking a scan to a permit.
    // Same split as /qr above, and it mattered more here: these mirrors carry
    // job location, hazards, the issuer's and holder's names, fire watchers and
    // the full participant list with each worker's employer — so a collection
    // list was a cross-tenant PII dump, not just an inventory leak.
    match /permitQr/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if isApprovedMemberOf(request.resource.data.orgId);
      allow update: if isApprovedMemberOf(resource.data.orgId)
        || isApprovedMemberOf(request.resource.data.orgId);
      allow delete: if isApprovedMemberOf(resource.data.orgId);
    }

    // ── Ported-module top-level collections (LOTO / hecp-loto) ─────────────────
    // These modules scope tenancy with an `orgId` field on each document instead
    // of an org subcollection path. Approved members of that org may read/write;
    // managers+ may delete. This wildcard returns false for every other top-level
    // collection (users, organizations, qr, orgIndex), which keep their own rules.
    function isLegacyOrgCollection(col) {
      return col in ['procedures', 'procedurePhotos', 'lotoEvents', 'locks', 'technicians', 'sites'];
    }
    match /{legacyCol}/{docId} {
      allow read: if isLegacyOrgCollection(legacyCol)
        && resource != null && isApprovedMemberOf(resource.data.orgId);
      allow create: if isLegacyOrgCollection(legacyCol)
        && isApprovedMemberOf(request.resource.data.orgId);
      allow update: if isLegacyOrgCollection(legacyCol)
        && ((resource != null && isApprovedMemberOf(resource.data.orgId))
            || isApprovedMemberOf(request.resource.data.orgId));
      allow delete: if isLegacyOrgCollection(legacyCol)
        && resource != null && isManagerOf(resource.data.orgId);
    }

    // ── User profiles ─────────────────────────────────────────────────────────
    match /users/{uid} {
      // Read your own profile, or — once you are an APPROVED member — any
      // profile in your organization.
      //
      // This used to say hasProfile(), which tests existence rather than
      // approval. Joining is self-service: anyone can create their own profile
      // as {status:'pending'} naming any orgId, and orgIds are public via
      // orgIndex. So a stranger could sign up against a company they have no
      // connection to and, while still sitting unapproved in that company's
      // queue, read its entire staff directory — every name, email, role and
      // department. Approval is the gate that was meant to be here; pending is
      // exactly the state that should see nothing but itself.
      allow read: if isSignedIn()
        && (request.auth.uid == uid
            || (isApprovedMemberOf(resource.data.orgId)
                && resource.data.orgId == myProfile().orgId));

      // Create your own profile (joining as a pending member, or — if you just
      // created the org — as its approved admin), OR an org admin provisions an
      // employee account for their own org (never directly as admin; admins are
      // promoted afterwards through the managed role update below).
      // The approved-admin self-create exists for one moment only: registering
      // a NEW organization, which writes the org doc and this user doc in one
      // batch. getAfter pins that: within the batch the org must exist with
      // createdBy == this caller. Without it, anyone could read an orgId out of
      // the public orgIndex and write themselves in as that org's admin.
      allow create: if isSignedIn()
        && (
          (request.auth.uid == uid
            && ((request.resource.data.status == 'pending' && request.resource.data.role != 'admin')
                || (request.resource.data.status == 'approved'
                    && request.resource.data.role == 'admin'
                    && getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)).data.createdBy == request.auth.uid)))
          || (isAdminOf(request.resource.data.orgId) && request.resource.data.role != 'admin')
        );

      // Update your own limited fields, or an admin manages members in the same
      // org. Users cannot self-promote (role/status locked unless admin).
      //
      // BOTH branches must pin orgId, and for a while only the first one did.
      // Because the branches are OR'd, an admin editing their OWN document took
      // the second branch — which constrained nothing — and could rewrite their
      // orgId to any value. Registering an org is open to anyone, so the whole
      // path was: sign up, create a throwaway org (you are its admin), read a
      // victim orgId out of the public orgIndex, then update your own profile to
      // {orgId: victim, role: admin, status: approved}. isAdminOf() reads the
      // profile you just wrote, so you land as an approved admin of an org you
      // have never belonged to, with read and write over all of its data.
      //
      // An admin manages members OF THEIR OWN ORG. Moving a person to a
      // different org — themselves most of all — is not management, and no
      // screen in the app does it.
      allow update: if isSignedIn()
        && request.resource.data.orgId == resource.data.orgId
        && (
          (request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.status == resource.data.status)
          || isAdminOf(resource.data.orgId)
        );

      allow delete: if isAdminOf(resource.data.orgId);
    }

    // ── Organizations & all org-scoped module data ────────────────────────────
    match /organizations/{orgId} {
      allow read: if isApprovedMemberOf(orgId);
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAdminOf(orgId);

      // Append-only audit trail — create only, never edit or delete. Declared
      // before the generic rule; the generic rule below excludes auditLogs so
      // this is the only rule that governs it.
      match /auditLogs/{logId} {
        allow read: if isApprovedMemberOf(orgId);
        allow create: if isApprovedMemberOf(orgId);
        allow update, delete: if false;
      }

      // One open report per defect per unit, enforced as a document rather than
      // a check. The QR reporter is not signed in and must never be able to
      // read the org's reports, so the client cannot look for a duplicate
      // before submitting — but creating a document that already exists fails
      // by itself. That is why update is denied here and why this collection is
      // carved out of the generic member rule below: if a member could update,
      // a second report would overwrite the lock instead of being refused.
      //
      // It holds no personal data, only which defect is live on which unit, and
      // is written in the same batch as the report it guards.
      match /defectLocks/{lockId} {
        allow read, delete: if isApprovedMemberOf(orgId);
        // Public, like the report it accompanies: a QR reporter has no account,
        // and a lock they cannot write is a lock that never blocks them.
        allow create: if request.resource.data.keys().hasOnly(['extId', 'defectType', 'createdAt'])
          && request.resource.data.extId is string
          && request.resource.data.extId.size() > 0
          && request.resource.data.extId.size() < 200
          && request.resource.data.defectType is string
          && request.resource.data.defectType.size() > 0
          && request.resource.data.defectType.size() <= 60;
        allow update: if false;
      }

      // Defect reports raised by scanning an equipment QR code. Whoever spots a
      // discharged extinguisher is rarely a portal user, and requiring an
      // account first is how defects go unreported — so an unauthenticated
      // create is allowed, but only in the exact shape the QR page produces:
      // a pending defect report that an approver must still accept. It cannot
      // be used to write an approved record, change status, or edit anything.
      // Note this is a public write surface; enable App Check to stop abuse.
      match /reports/{reportId} {
        allow create: if isApprovedMemberOf(orgId) || (
          request.resource.data.source == 'qr'
          && request.resource.data.approvalStatus == 'pending'
          && request.resource.data.reportedBy == 'public'
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 500
          && (
            // An extinguisher defect, keyed by the unit it was raised against.
            (
              request.resource.data.kind == 'defect'
              && request.resource.data.extId is string
              && request.resource.data.extId.size() > 0
              && request.resource.data.extId.size() < 200
            )
            // An AED or fire-alarm fault. Same public surface, different sheet:
            // these carry no extId, so the extinguisher clause above can never
            // admit them and they need their own shape. assetKind is pinned to
            // the two known kinds because approving one writes to the matching
            // collection — an unrecognised kind would target nothing.
            || (
              request.resource.data.kind == 'asset_defect'
              && request.resource.data.assetKind in ['aed', 'fas']
              && request.resource.data.assetRefId is string
              && request.resource.data.assetRefId.size() > 0
              && request.resource.data.assetRefId.size() < 200
              && request.resource.data.defect is string
              && request.resource.data.defect.size() > 0
              && request.resource.data.defect.size() <= 200
            )
          )
        );
      }

      // Observations logged by scanning a work permit's QR code. Whoever walks
      // past unsafe hot work is usually not a portal user, and requiring an
      // account first is how it goes unreported — so an unauthenticated create
      // is allowed, but only in the exact shape the public permit page writes.
      //
      // It lands pending and touches nothing else. A signed-in "unsafe"
      // observation closes the permit for non-compliance on the spot; allowing
      // that here would put a stop-work button on a token printed on a sheet of
      // paper, so the scan reports and a person decides.
      //
      // Note this is a public write surface; enable App Check to stop abuse.
      match /observations/{obsId} {
        allow create: if isApprovedMemberOf(orgId) || (
          request.resource.data.source == 'qr'
          && request.resource.data.approvalStatus == 'pending'
          && request.resource.data.observedBy == 'public'
          && request.resource.data.type in ['safe', 'unsafe']
          && request.resource.data.permitId is string
          && request.resource.data.permitId.size() > 0
          && request.resource.data.permitId.size() < 200
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 500
        );
      }

      // Document-id counters, one document per kind, holding a single integer.
      //
      // Every member must be able to increment these — reserving an id is what
      // creating any record does — but a counter that can move BACKWARDS hands
      // the next record an id already printed on a permit and quoted in the
      // audit trail. The transaction in reserve.js protects against two people
      // at once; it does nothing against one person choosing to rewind it.
      //
      // So: strictly monotonic, enforced here where it cannot be bypassed. One
      // document per kind rather than one document with a field per kind
      // because rules cannot compare a dynamically-named field — splitting the
      // path is what makes the guarantee expressible at all.
      match /docSeq/{kind} {
        allow read: if isApprovedMemberOf(orgId);
        allow create: if isApprovedMemberOf(orgId)
          && request.resource.data.keys().hasOnly(['n'])
          && request.resource.data.n is int
          && request.resource.data.n > 0;
        allow update: if isApprovedMemberOf(orgId)
          && request.resource.data.keys().hasOnly(['n'])
          && request.resource.data.n is int
          && request.resource.data.n > resource.data.n;
        allow delete: if false;
      }

      // Generic module data (incidents, assessments, permits, inspections,
      // extinguishers, meetings, meta/stats, sites, notifications, …). Approved
      // members read/create/update; managers+ delete. auditLogs is excluded so
      // it keeps its append-only rule above.
      match /{col}/{docId} {
        // defectLocks joins auditLogs in being excluded: its whole purpose is
        // that a create fails on an existing document, which a generic update
        // permission would quietly defeat. docSeq likewise: its monotonic rule
        // above is the guarantee, and a generic update would erase it.
        allow read, create, update: if col != 'auditLogs' && col != 'defectLocks' && col != 'docSeq' && isApprovedMemberOf(orgId);
        allow delete: if col != 'auditLogs' && col != 'docSeq' && isManagerOf(orgId);

        // Nested subcollections (e.g. incidents/{id}/photos, documents/{id}/versions).
        // The recursive wildcard also matches the parent {col}/{docId} itself, so
        // it must repeat the auditLogs guard — otherwise it would silently reopen
        // updates/deletes on the append-only audit trail. The same applies to
        // defectLocks, whose create-only rule is the duplicate check.
        match /{sub=**} {
          allow read, create, update: if col != 'auditLogs' && col != 'defectLocks' && col != 'docSeq' && isApprovedMemberOf(orgId);
          allow delete: if col != 'auditLogs' && col != 'docSeq' && isManagerOf(orgId);
        }
      }
    }
  }
}
