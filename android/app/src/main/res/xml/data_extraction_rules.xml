<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later, which is every device this app targets (targetSdk 36)
     once it is running API 31+. The older backup_rules.xml does not govern
     device-to-device transfer here. A missing device-transfer section means
     that transfer is fully enabled, including on manufacturers that ignore
     allowBackup false. An empty section is the same as a missing one: every
     domain is excluded on purpose.

     disableIfNoEncryptionCapabilities refuses a cloud copy when the device
     cannot encrypt it. It does not apply to device-to-device transfer; the
     excludes in device-transfer are what stop that copy. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
